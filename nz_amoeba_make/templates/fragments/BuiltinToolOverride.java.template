// [CAPABILITY: override a built-in MCP tool] Requires protean.mcp.enabled=true.
// McpDispatcher keeps tools in a Map<name, McpTool> (last-write-wins) and exposes registerTool(...) to
// register/replace at runtime. A Registrar (ApplicationRunner) looks up the built-in by name and replaces it
// with a wrapper that DELEGATES to the original (preserving real behavior) and augments the result. This example
// wraps protean.module_metrics. Injection via ObjectProvider so the app still boots when MCP is disabled.
package {{PKG}};

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.node.ObjectNode;

import org.htcom.protean.mcp.McpCallContext;
import org.htcom.protean.mcp.McpDispatcher;
import org.htcom.protean.mcp.McpTool;
import org.htcom.protean.mcp.McpToolResult;
import org.htcom.protean.mcp.McpToolAnnotations;
import org.htcom.protean.mcp.ModuleActionAuthorizer;

import org.springframework.beans.factory.ObjectProvider;
import org.springframework.boot.ApplicationArguments;
import org.springframework.boot.ApplicationRunner;
import org.springframework.stereotype.Component;

import java.util.List;
import java.util.concurrent.atomic.AtomicLong;

public final class ExampleToolOverride implements McpTool {

    private static final String TARGET = "protean.module_metrics";

    private final McpTool delegate;
    private final AtomicLong calls = new AtomicLong();

    ExampleToolOverride(McpTool delegate) {
        this.delegate = delegate;
    }

    @Override public String name() { return delegate.name(); }        // same name → replaces the built-in
    @Override public String description() { return delegate.description() + " [overridden by {{NAME}}]"; }
    @Override public ObjectNode inputSchema() { return delegate.inputSchema(); }
    @Override public ObjectNode outputSchema() { return delegate.outputSchema(); }
    @Override public String title() { return delegate.title(); }
    @Override public McpToolAnnotations annotations() { return delegate.annotations(); }
    @Override public ModuleActionAuthorizer.ModuleAction action() { return delegate.action(); }

    @Override
    public McpToolResult call(JsonNode arguments, McpCallContext ctx) {
        McpToolResult r = delegate.call(arguments, ctx);  // preserve built-in behavior
        long seq = calls.incrementAndGet();
        if (!r.isError() && r.structured() instanceof ObjectNode structured) {
            structured.put("observedByOverride", true);
            structured.put("callSeq", seq);
            return McpToolResult.ok(r.text() + " [via {{NAME}} override #" + seq + "]", structured);
        }
        return r;
    }

    /** Registers the override at startup. Skips silently when MCP is disabled (no McpDispatcher bean). */
    @Component
    static class Registrar implements ApplicationRunner {
        private final ObjectProvider<McpDispatcher> dispatcher;
        private final List<McpTool> tools;

        Registrar(ObjectProvider<McpDispatcher> dispatcher, List<McpTool> tools) {
            this.dispatcher = dispatcher;
            this.tools = tools;
        }

        @Override
        public void run(ApplicationArguments args) {
            McpDispatcher d = dispatcher.getIfAvailable();
            if (d == null) {
                return; // MCP disabled — nothing to override
            }
            tools.stream()
                    .filter(t -> TARGET.equals(t.name()))
                    .findFirst()
                    .ifPresent(original -> d.registerTool(new ExampleToolOverride(original)));
        }
    }
}
