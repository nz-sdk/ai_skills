// An in-memory H2 database shaped to trip every quirk DbMetadataReader absorbs, plus the one assertion the db tool
// tests share.
//
// H2 is on the TEST RUNTIME classpath only (protean declares it at Maven runtime scope), so it is reached through
// a JDBC URL and Spring's DriverManagerDataSource — never an org.h2 import, which would not compile.
//
// Unquoted names fold to upper case in H2 (comp_mst → COMP_MST): that is what exercises the case-insensitive
// lookup. COMP_MST / COMPXMST differ exactly where '_' sits, so treating the name as a LIKE pattern leaks the
// second table's columns into the first.
package {{PKG}}.db;

import com.fasterxml.jackson.databind.JsonNode;

import org.htcom.protean.mcp.McpTool;
import org.htcom.protean.mcp.McpToolResult;
import org.springframework.jdbc.datasource.DriverManagerDataSource;

import javax.sql.DataSource;
import java.sql.Connection;
import java.sql.SQLException;
import java.sql.Statement;
import java.util.UUID;

import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertNotNull;
import static org.junit.jupiter.api.Assertions.assertTrue;

final class DbFixtures {

    static final String[] SCHEMA = {
            """
            CREATE TABLE comp_mst (
              comp_cd VARCHAR(10)  NOT NULL,
              comp_nm VARCHAR(100) NOT NULL,
              use_yn  CHAR(1)      DEFAULT 'Y',
              CONSTRAINT pk_comp_mst PRIMARY KEY (comp_cd),
              CONSTRAINT uk_comp_nm UNIQUE (comp_nm)
            )""",
            "COMMENT ON TABLE comp_mst IS '회사 마스터'",
            "COMMENT ON COLUMN comp_mst.comp_cd IS '회사코드'",
            "COMMENT ON COLUMN comp_mst.comp_nm IS '회사명'",
            "CREATE TABLE compxmst (trap_col INT)",
            """
            CREATE TABLE emp (
              emp_id  BIGINT GENERATED BY DEFAULT AS IDENTITY,
              comp_cd VARCHAR(10) NOT NULL,
              emp_nm  VARCHAR(50),
              salary  DECIMAL(12,2),
              CONSTRAINT pk_emp PRIMARY KEY (emp_id),
              CONSTRAINT fk_emp_comp FOREIGN KEY (comp_cd) REFERENCES comp_mst (comp_cd) ON DELETE CASCADE
            )""",
            "CREATE INDEX ix_emp_nm ON emp (emp_nm)",
            "COMMENT ON TABLE emp IS '사원'",
            "CREATE VIEW v_active_comp AS SELECT comp_cd, comp_nm FROM comp_mst WHERE use_yn = 'Y'",
    };

    /** Tables the base schema produces, as H2 stores them. */
    static final int TABLE_COUNT = 3;
    static final int VIEW_COUNT = 1;

    private DbFixtures() {
    }

    /** A fresh, isolated database with {@link #SCHEMA} applied. Each call gets its own name, so tests never share. */
    static DataSource database() {
        DriverManagerDataSource ds = new DriverManagerDataSource(
                "jdbc:h2:mem:dbtools_" + UUID.randomUUID().toString().replace("-", "") + ";DB_CLOSE_DELAY=-1");
        exec(ds, SCHEMA);
        return ds;
    }

    static void exec(DataSource ds, String... statements) {
        try (Connection conn = ds.getConnection(); Statement st = conn.createStatement()) {
            for (String sql : statements) {
                st.execute(sql);
            }
        } catch (SQLException e) {
            throw new IllegalStateException("fixture DDL failed: " + e.getMessage(), e);
        }
    }

    /**
     * Asserts a successful result satisfies the {@code required} fields of the tool's own {@code outputSchema()}.
     *
     * <p>Worth asserting because the failure is invisible in-process: {@code McpDispatcher} checks conformance on
     * the way out and rewrites a non-conforming success into an {@code OUTPUT_SCHEMA_VIOLATION} error, so a tool
     * that omits a field it declared required works in a unit test and fails over the wire. Kept here rather than
     * shared with the source/ bundle's SourceToolAssertions: the two bundles are independent capabilities.
     */
    static void assertSatisfiesOutputSchema(McpTool tool, McpToolResult result) {
        assertFalse(result.isError(), () -> "expected a successful result, got: " + result.text());
        JsonNode structured = result.structured();
        assertNotNull(structured, "a tool declaring an outputSchema must return structuredContent");
        assertTrue(structured.isObject(), "structuredContent must be an object per the MCP spec");
        for (JsonNode field : tool.outputSchema().path("required")) {
            String name = field.asText();
            assertTrue(structured.hasNonNull(name),
                    () -> "structuredContent is missing the required field '" + name + "'");
        }
    }
}
