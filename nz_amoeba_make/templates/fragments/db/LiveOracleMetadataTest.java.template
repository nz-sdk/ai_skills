// LiveVendorMetadataContract against a real Oracle through ojdbc11 — plus what only Oracle does: comments that the
// driver never reports (VendorComments reads ALL_*_COMMENTS), a NULL UPDATE_RULE, bare NUMBER, defaults with
// trailing whitespace, the recycle bin, and no database level.
//
//   docker run -d --name dbtools-ora -e ORACLE_PASSWORD=pw -e APP_USER=probe -e APP_USER_PASSWORD=pw \
//     -p 11521:1521 gvenzl/oracle-free:23-slim          # ready when the log says DATABASE IS READY TO USE
//   DB_TOOLS_TEST_ORACLE_URL='jdbc:oracle:thin:@//127.0.0.1:11521/FREEPDB1' DB_TOOLS_TEST_ORACLE_USER=probe \
//     DB_TOOLS_TEST_ORACLE_PASSWORD=pw ./gradlew test --tests '*LiveOracleMetadataTest'
//   docker rm -f dbtools-ora
package {{PKG}}.db;

import com.fasterxml.jackson.databind.JsonNode;

import org.htcom.protean.mcp.McpToolResult;
import org.junit.jupiter.api.Test;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertTrue;

class LiveOracleMetadataTest extends LiveVendorMetadataContract {

    private static final String BINNED = "zz_dbtools_probe_binned";

    @Override
    String envPrefix() {
        return "DB_TOOLS_TEST_ORACLE";
    }

    @Override
    DbVendor vendor() {
        return DbVendor.ORACLE;
    }

    @Override
    String[] createProbe() {
        return new String[] {
                "CREATE TABLE " + PARENT + " (id NUMBER(19) GENERATED BY DEFAULT AS IDENTITY,"
                        + " code VARCHAR2(20) NOT NULL, amount NUMBER, use_yn CHAR(1) DEFAULT 'Y' ,"
                        + " CONSTRAINT pk_zz_probe_parent PRIMARY KEY (id),"
                        + " CONSTRAINT uk_zz_probe_code UNIQUE (code))",
                "COMMENT ON TABLE " + PARENT + " IS '" + PARENT_COMMENT + "'",
                "COMMENT ON COLUMN " + PARENT + ".id IS '" + ID_COMMENT + "'",
                "CREATE TABLE " + CHILD + " (id NUMBER(19) NOT NULL, parent_id NUMBER(19) NOT NULL,"
                        + " CONSTRAINT pk_zz_probe_child PRIMARY KEY (id),"
                        + " CONSTRAINT fk_zz_probe_parent FOREIGN KEY (parent_id) REFERENCES " + PARENT
                        + " (id) ON DELETE CASCADE)",
                "COMMENT ON TABLE " + CHILD + " IS '" + CHILD_COMMENT + "'",
                "CREATE VIEW " + VIEW + " AS SELECT id, code FROM " + PARENT,
                // Dropped WITHOUT purge: it lands in the recycle bin as BIN$…, which list_tables must not show.
                "CREATE TABLE " + BINNED + " (x NUMBER)",
                "DROP TABLE " + BINNED,
        };
    }

    @Override
    String[] dropProbe() {
        return new String[] {"DROP VIEW " + VIEW, "DROP TABLE " + CHILD + " PURGE", "DROP TABLE " + PARENT + " PURGE",
                "DROP TABLE " + BINNED + " PURGE", "PURGE RECYCLEBIN"};
    }

    @Override
    String[] refusedSystemLocation() {
        return new String[] {"schema", "SYSTEM"};
    }

    @Test
    void bareNumberAndTrailingWhitespaceDefaultsReadAsDeclared() {
        JsonNode parent = describe(PARENT);
        assertEquals("NUMBER", column(parent, "amount").path("type").asText(), parent.toString());
        assertEquals("'Y'", column(parent, "use_yn").path("default").asText(), parent.toString());
        assertTrue(column(parent, "id").path("autoIncrement").asBoolean(), parent.toString());
    }

    @Test
    void theRecycleBinIsNotListed() {
        ListTablesTool tool = new ListTablesTool(mapper, new DbMetadataReader(database));
        JsonNode s = tool.call(mapper.createObjectNode().put("limit", 0), null).structured();
        s.path("tables").forEach(t -> assertFalse(t.path("name").asText().startsWith("BIN$"), s.toString()));
    }

    @Test
    void aDatabaseArgumentPointsAtSchemaInstead() {
        ListTablesTool tool = new ListTablesTool(mapper, new DbMetadataReader(database));
        McpToolResult result = tool.call(mapper.createObjectNode().put("database", "anything"), null);
        assertTrue(result.isError() && result.text().contains("'schema'"), result.text());
    }
}
