// [MODULE SOURCE] Reconstructs build.gradle/settings.gradle for an exported module.
//
// These files are an EDITING AID, not a reproduction of the deployment. A protean module deploys as source and is
// compiled in-process by the host, inheriting the HOST's java.class.path — there is no per-module build file
// anywhere in the system, so nothing here can be "the real one". What it produces is a classpath close enough for
// an IDE to resolve a generated skeleton's imports, and the header comment written into the file says so, because
// a build.gradle that looks authoritative but is not would be worse than none at all.
package {{PKG}}.source;

import org.htcom.protean.module.ModuleDescriptor;
import org.htcom.protean.module.ModuleResource;

import java.nio.charset.StandardCharsets;
import java.util.List;
import java.util.Locale;
import java.util.Map;

final class BuildFileWriter {

    // Mirrors prototype/nz_amoeba/build.gradle, the host these modules actually compile against. If the host's
    // versions move, these follow — they are a snapshot, which is exactly why the generated header says so.
    private static final String BOOT_VERSION = "3.5.16";
    private static final String DEPENDENCY_MANAGEMENT_VERSION = "1.1.7";
    private static final String SWAGGER_VERSION = "2.2.22";
    private static final String MYBATIS_VERSION = "3.5.19";
    private static final String MYBATIS_SPRING_VERSION = "3.0.4";
    private static final int JAVA_VERSION = 21;

    private BuildFileWriter() {
    }

    /** One generated project file. Not a {@link ModuleSourceLayout.SourceFile} — nothing stored it in the module. */
    record BuildFile(String path, String content) {

        int bytes() {
            return content.getBytes(StandardCharsets.UTF_8).length;
        }
    }

    static List<BuildFile> of(ModuleDescriptor descriptor) {
        return List.of(
                new BuildFile("settings.gradle", settingsGradle(descriptor)),
                new BuildFile("build.gradle", buildGradle(descriptor)));
    }

    private static String settingsGradle(ModuleDescriptor descriptor) {
        return """
                // Generated by amoeba.export_module_source. See build.gradle for what these files are and are not.
                rootProject.name = '%s'
                """.formatted(descriptor.id());
    }

    private static String buildGradle(ModuleDescriptor descriptor) {
        StringBuilder deps = new StringBuilder();
        deps.append("    implementation 'org.springframework.boot:spring-boot-starter-web'\n");
        deps.append("    implementation 'io.swagger.core.v3:swagger-annotations:")
                .append(SWAGGER_VERSION).append("'\n");
        if (usesMyBatis(descriptor)) {
            deps.append("\n    // This module carries MyBatis artifacts (a mapper XML resource, or it injects a host\n");
            deps.append("    // bean — today that means the DataSource behind a MyBatis skeleton).\n");
            deps.append("    implementation 'org.springframework.boot:spring-boot-starter-jdbc'\n");
            deps.append("    implementation 'org.mybatis:mybatis:").append(MYBATIS_VERSION).append("'\n");
            deps.append("    implementation 'org.mybatis:mybatis-spring:")
                    .append(MYBATIS_SPRING_VERSION).append("'\n");
        }
        if (descriptor.tests() != null && !descriptor.tests().isEmpty()) {
            deps.append("\n    testImplementation 'org.springframework.boot:spring-boot-starter-test'\n");
        }

        return """
                // Generated by amoeba.export_module_source for module '%s' version %s.
                //
                // EDITING AID ONLY — this is NOT the classpath the deployment compiles against. A protean module
                // deploys as SOURCE and is compiled in-process by the host application, inheriting the host's
                // java.class.path; no per-module build file exists on the server. The dependencies below are a
                // reconstruction good enough for an IDE to resolve this module's imports, and the versions are a
                // snapshot of the host's at export time — they can drift.
                //
                // Do not deploy from here. Redeploy through the MCP flow (amoeba.define_interface ->
                // protean.deploy_module), which is what regenerates the server-owned files from the interface spec.
                plugins {
                    id 'java'
                    id 'io.spring.dependency-management' version '%s'
                }

                repositories {
                    mavenCentral()
                }

                java {
                    toolchain {
                        languageVersion = JavaLanguageVersion.of(%d)
                    }
                }

                dependencyManagement {
                    imports {
                        mavenBom 'org.springframework.boot:spring-boot-dependencies:%s'
                    }
                }

                dependencies {
                %s}

                tasks.named('test') {
                    useJUnitPlatform()
                }
                """.formatted(descriptor.id(), descriptor.version(), DEPENDENCY_MANAGEMENT_VERSION,
                JAVA_VERSION, BOOT_VERSION, deps);
    }

    /**
     * Whether the module looks like a MyBatis skeleton.
     *
     * <p>A heuristic by necessity: the descriptor records no {@code dataAccess} field, so this reads two
     * independent signals — an XML resource (the mapper), and {@code needsSharedBeans}, which is true exactly
     * when the module injects a host bean and today that means the {@code DataSource} behind a MyBatis skeleton.
     * Guessing wrong only adds or omits an unused IDE dependency, which is why a heuristic is acceptable here.
     */
    private static boolean usesMyBatis(ModuleDescriptor descriptor) {
        if (descriptor.needsSharedBeans()) {
            return true;
        }
        Map<String, ModuleResource> resources = descriptor.resources();
        if (resources == null) {
            return false;
        }
        return resources.keySet().stream()
                .anyMatch(path -> path != null && path.toLowerCase(Locale.ROOT).endsWith(".xml"));
    }
}
