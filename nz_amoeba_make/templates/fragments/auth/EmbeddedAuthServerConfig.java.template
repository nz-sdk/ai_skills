@Configuration(proxyBeanMethods = false)
@EnableConfigurationProperties(EmbeddedAuthProperties.class)
@ConditionalOnProperty(prefix = "amoeba.auth", name = "enabled", havingValue = "true")
public class EmbeddedAuthServerConfig {

    private static final Logger log = LoggerFactory.getLogger(EmbeddedAuthServerConfig.class);

    /** The only scopes this AS will ever mint. Kept in sync with ApiModuleActionAuthorizer. */
    private static final List<String> MCP_SCOPES = List.of("mcp.read", "mcp.write", "mcp.admin");

    private final EmbeddedAuthProperties props;
    private final String issuer;
    private final String resourceId;

    /**
     * Startup fail-fast, in the style of {@code SecurityConfig}'s constructor.
     *
     * <p>The issuer must be pinned when embedded. Letting Spring Authorization Server derive it from the request
     * host would make the {@code iss} claim vary by how a caller reached the app, while the Resource Server half
     * validates against one fixed string — tokens would verify or not depending on the URL used to get them.
     */
    EmbeddedAuthServerConfig(
            EmbeddedAuthProperties props,
            @Value("${spring.security.oauth2.resourceserver.jwt.issuer-uri:}") String issuer,
            @Value("${protean.mcp.authorization.resource:}") String resourceId) {
        if (issuer.isBlank() || issuer.contains("${") || !issuer.startsWith("http")) {
            throw new IllegalStateException("""
                    amoeba.auth.enabled=true needs a pinned issuer, but \
                    spring.security.oauth2.resourceserver.jwt.issuer-uri resolved to '""" + issuer + """
                    '. When this app issues its own tokens the issuer is THIS app's externally visible base URL:

                      export OAUTH_ISSUER_URI=http://localhost:8080     # must match SERVER_HOST/SERVER_PORT

                    It is the exact 'iss' string the tokens will carry and the value the Resource Server half \
                    checks, so it cannot be derived per-request. See README §Security.""");
        }
        this.props = props;
        this.issuer = issuer;
        this.resourceId = resourceId;
    }

    /**
     * Loud on purpose. This is the one configuration in the app that trades a security boundary for convenience,
     * and the person who turned it on is not always the person who later deploys it.
     */
    @PostConstruct
    void warnLoudly() {
        log.warn("""

                ╔═══════════════════════════════════════════════════════════════════════════════╗
                ║  ⚠  EMBEDDED AUTHORIZATION SERVER IS ON (amoeba.auth.enabled=true)
                ║     This app now signs the tokens it validates. The signing key ({})
                ║     lives in the same JVM as /platform/mcp, which compiles and runs submitted
                ║     code with no sandbox — a module deployed with mcp.write can read that key
                ║     and mint mcp.admin.
                ║
                ║     Tokens are audience-locked to {} so they are useless elsewhere.
                ║     Do NOT point another service at this issuer.
                ║
                ║     Production: amoeba.auth.enabled=false + OAUTH_ISSUER_URI=<real IdP>
                ╚═══════════════════════════════════════════════════════════════════════════════╝""",
                props.jwksPath(), resourceId.isBlank() ? issuer : resourceId);
    }

    /**
     * AS endpoints only. {@code getEndpointsMatcher()} scopes this chain to {@code /oauth2/**} and the
     * authorization-server metadata, so SecurityConfig's chains keep matching exactly what they matched before.
     *
     * <p>The login redirect is wired explicitly: {@code applyDefaultSecurity} does NOT install one (verified
     * against the SAS 1.5.8 bytecode — it only sets a securityMatcher, registers the configurer and requires
     * authentication). Without this, a browser hitting {@code /oauth2/authorize} gets a bare 401 and the
     * authorization_code flow never starts. Scoped to TEXT_HTML so a token request still fails as a 401 rather
     * than being handed a redirect to a login page.
     */
    @Bean
    @Order(0)
    @SuppressWarnings("removal")
    SecurityFilterChain authorizationServerFilterChain(
            HttpSecurity http, RegisteredClientRepository registeredClients) throws Exception {
        OAuth2AuthorizationServerConfiguration.applyDefaultSecurity(http);
        http.getConfigurer(OAuth2AuthorizationServerConfigurer.class)
                .oidc(Customizer.withDefaults());

        if (props.refreshTokenEnabled()) {
            // ★ Second half of public-client refresh. Issuing the token (see #tokenGenerator) is not enough:
            // Spring's PublicClientAuthenticationConverter bails out unless the request is a PKCE
            // authorization_code exchange, so a public client presenting grant_type=refresh_token is never
            // authenticated at all and the token endpoint answers {"error":"invalid_client"} — before the refresh
            // grant is even reached. These two plug that one hole and nothing else.
            //
            // Ordering is load-bearing and it is in our favour: OAuth2ClientAuthenticationConfigurer inserts
            // custom converters and providers with addAll(0, ...), so both run BEFORE the built-ins. That matters
            // because Spring's own PublicClientAuthenticationProvider also claims NONE tokens and would demand a
            // code_verifier that a refresh request does not carry.
            http.getConfigurer(OAuth2AuthorizationServerConfigurer.class)
                    .clientAuthentication(clientAuth -> clientAuth
                            .authenticationConverter(new PublicClientRefreshAuthenticationConverter())
                            .authenticationProvider(
                                    new PublicClientRefreshAuthenticationProvider(registeredClients)));
        }
        http.exceptionHandling(exceptions -> exceptions.defaultAuthenticationEntryPointFor(
                new LoginUrlAuthenticationEntryPoint("/login"),
                new MediaTypeRequestMatcher(MediaType.TEXT_HTML)));
        return http.build();
    }

    @Bean
    AuthorizationServerSettings authorizationServerSettings() {
        return AuthorizationServerSettings.builder().issuer(issuer).build();
    }

    /**
     * Registered clients — only {@code mcp.*} scopes are ever offered, by design (see the header).
     *
     * <p>The MCP client is public + PKCE: Claude Code and mcp-remote cannot keep a secret, which is exactly what
     * OAuth 2.1 means by a public client. Spring Authorization Server refuses to issue refresh tokens to such a
     * client ({@code OAuth2RefreshTokenGenerator} returns null for authorization_code + NONE), so by default a
     * browser login has to be repeated once the access token expires. Setting
     * {@code amoeba.auth.refresh-token-enabled=true} overrides that — see {@link #tokenGenerator}.
     */
    @Bean
    RegisteredClientRepository registeredClientRepository() {
        List<RegisteredClient> clients = new ArrayList<>();

        // ★ THE ID IS A STABLE LITERAL, NOT A RANDOM UUID. With authorization-store=jdbc this string is written to
        // oauth2_authorization.registered_client_id and resolved back through this repository on every load, so a
        // UUID minted per boot makes every stored authorization unreadable after a restart
        // ("The RegisteredClient with id '...' was not found") — silently undoing the point of persisting them.
        // The clientId is already unique here, so it is the natural key.
        RegisteredClient.Builder agent = RegisteredClient.withId(props.mcpClientId())
                .clientId(props.mcpClientId())
                .clientAuthenticationMethod(ClientAuthenticationMethod.NONE)
                .authorizationGrantType(AuthorizationGrantType.AUTHORIZATION_CODE)
                .clientSettings(ClientSettings.builder()
                        .requireProofKey(true)
                        // SAS ships no consent page; supplying one is the consumer's job. An internal tool has no
                        // scope for the user to choose, so it is skipped. Revisit if this is ever exposed outside.
                        .requireAuthorizationConsent(false)
                        .build())
                .tokenSettings(agentTokenSettings());
        if (props.refreshTokenEnabled()) {
            agent.authorizationGrantType(AuthorizationGrantType.REFRESH_TOKEN);
        }
        MCP_SCOPES.forEach(agent::scope);
        props.mcpRedirectUris().forEach(uri -> agent.redirectUri(uri.trim()));
        clients.add(agent.build());

        // Optional machine client. Absent unless an id AND a secret are configured — half-configured credentials
        // would otherwise register a client nobody can authenticate as.
        if (!props.serviceClientId().isBlank() && !props.serviceClientSecret().isBlank()) {
            // Stable id for the same reason as the agent client above.
            RegisteredClient.Builder service = RegisteredClient.withId(props.serviceClientId())
                    .clientId(props.serviceClientId())
                    .clientSecret("{noop}" + props.serviceClientSecret())
                    .clientAuthenticationMethod(ClientAuthenticationMethod.CLIENT_SECRET_BASIC)
                    .authorizationGrantType(AuthorizationGrantType.CLIENT_CREDENTIALS)
                    .tokenSettings(TokenSettings.builder().accessTokenTimeToLive(props.accessTokenTtl()).build());
            MCP_SCOPES.forEach(service::scope);
            clients.add(service.build());
        }
        return new InMemoryRegisteredClientRepository(clients);
    }

    /**
     * Access-token lifetime always; refresh settings only when enabled.
     *
     * <p>{@code reuseRefreshTokens(false)} is not a tuning knob — Spring's default is reuse, which would make the
     * refresh token a STATIC bearer valid for its whole lifetime. For a PUBLIC client that is precisely the shape
     * OAuth 2.1 rules out, and it is the only reason issuing one here is defensible: with rotation each refresh
     * mints a new token and invalidates the old one, so a captured token is single-use and replay is detected.
     */
    private TokenSettings agentTokenSettings() {
        TokenSettings.Builder tokens = TokenSettings.builder()
                .accessTokenTimeToLive(props.accessTokenTtl());
        if (props.refreshTokenEnabled()) {
            tokens.refreshTokenTimeToLive(props.refreshTokenTtl())
                    .reuseRefreshTokens(false);
        }
        return tokens.build();
    }

    /**
     * Two jobs, both load-bearing.
     *
     * <p><b>Audience lock.</b> Every access token carries {@code aud} = this app's resource identifier. That is
     * what keeps the blast radius of the embedded key inside this app: a token minted here is not valid anywhere
     * that checks its audience.
     *
     * <p><b>Scope narrowing.</b> Issued scope = requested ∩ the logged-in user's {@code mcp.*} authorities. This
     * is the ONLY place per-user differentiation can happen: ApiModuleActionAuthorizer reads scopes off the token
     * and never looks the user up again (it is a stateless Resource Server). A client_credentials token has no
     * user, so it is left alone — its ceiling is the RegisteredClient's own scope list.
     */
    @Bean
    OAuth2TokenCustomizer<JwtEncodingContext> tokenCustomizer() {
        return context -> {
            if (!OAuth2TokenType.ACCESS_TOKEN.equals(context.getTokenType())) {
                return;
            }
            if (!resourceId.isBlank()) {
                // ★ ArrayList, NOT List.of(). With authorization-store=jdbc these claims are written to
                // oauth2_authorization.access_token_metadata and read back through Spring Security's ALLOWLISTED
                // ObjectMapper. java.util.ImmutableCollections$List12 is not on that allowlist, so List.of() makes
                // every refresh fail with "The class ... is not in the allowlist" — a 500 at /oauth2/token, long
                // after this line ran fine at issuance. Same reason for the scope claim below.
                context.getClaims().audience(new ArrayList<>(List.of(resourceId)));
            }
            if (context.getPrincipal() == null || context.getPrincipal().getAuthorities() == null) {
                return;
            }
            Set<String> userScopes = context.getPrincipal().getAuthorities().stream()
                    .map(GrantedAuthority::getAuthority)
                    .filter(a -> a.startsWith("mcp."))
                    .collect(Collectors.toSet());
            if (userScopes.isEmpty()) {
                return; // not user-based (client_credentials) — leave untouched
            }
            Set<String> granted = new HashSet<>(context.getAuthorizedScopes());
            granted.retainAll(userScopes);
            // ArrayList for the allowlist reason above; sorted so the claim is stable across issuances.
            List<String> scopes = new ArrayList<>(granted);
            Collections.sort(scopes);
            context.getClaims().claim("scope", scopes);
        };
    }

    // ── refresh tokens for a PUBLIC client (amoeba.auth.refresh-token-enabled=true) ────────────────────────────
    //
    // Spring blocks this in exactly two places and both are opened below, deliberately and narrowly:
    //   1. OAuth2RefreshTokenGenerator.generate() returns null when isPublicClientForAuthorizationCodeGrant()
    //      holds — grant is authorization_code AND the client authenticated with NONE.  →  #tokenGenerator
    //   2. PublicClientAuthenticationConverter.convert() returns null unless the request is a PKCE code
    //      exchange, so a refresh request from a public client is never authenticated at all and the token
    //      endpoint answers invalid_client.  →  the converter/provider pair, wired in the filter chain above.
    // OAuth2RefreshTokenAuthenticationProvider's own NONE check is DPoP key binding, NOT a refusal — redeeming is
    // fine once the two above are handled. Verified against the 1.5.8 bytecode.

    /**
     * Replaces Spring's default token generator for ONE reason: to issue a refresh token to this public client.
     * Everything else is Spring's own default wiring, reproduced.
     *
     * <p><b>★ The customizer must be re-attached by hand, and that is the dangerous part of this bean.</b> Spring
     * wires {@link #tokenCustomizer()} into the default {@code JwtGenerator} for us; supplying our own generator
     * takes that wiring over. Drop the {@code setJwtCustomizer} line and the audience lock disappears AND per-user
     * scope narrowing stops — a read-only user would silently receive {@code mcp.write}. The generated
     * {@code EmbeddedAuthRefreshTest} asserts both survive a refresh; keep it.
     */
    @Bean
    @ConditionalOnProperty(prefix = "amoeba.auth", name = "refresh-token-enabled", havingValue = "true")
    OAuth2TokenGenerator<OAuth2Token> tokenGenerator(
            JWKSource<SecurityContext> jwkSource,
            OAuth2TokenCustomizer<JwtEncodingContext> jwtCustomizer) {

        JwtGenerator jwtGenerator = new JwtGenerator(new NimbusJwtEncoder(jwkSource));
        jwtGenerator.setJwtCustomizer(jwtCustomizer);   // ★ see the paragraph above before touching this line

        return new DelegatingOAuth2TokenGenerator(
                jwtGenerator,
                new OAuth2AccessTokenGenerator(),
                new PublicClientRefreshTokenGenerator());
    }

    /**
     * Spring's {@code OAuth2RefreshTokenGenerator}, verbatim except for the public-client guard. Same 96-byte
     * Base64url opaque value, same clock source, same {@code refreshTokenTimeToLive} lookup — so the token is
     * indistinguishable from one Spring would have produced for a confidential client.
     */
    static final class PublicClientRefreshTokenGenerator implements OAuth2TokenGenerator<OAuth2RefreshToken> {

        private final StringKeyGenerator refreshTokenGenerator =
                new Base64StringKeyGenerator(Base64.getUrlEncoder().withoutPadding(), 96);

        @Override
        public OAuth2RefreshToken generate(OAuth2TokenContext context) {
            if (!OAuth2TokenType.REFRESH_TOKEN.equals(context.getTokenType())) {
                return null;
            }
            Instant issuedAt = Instant.now();
            Instant expiresAt = issuedAt.plus(
                    context.getRegisteredClient().getTokenSettings().getRefreshTokenTimeToLive());
            return new OAuth2RefreshToken(this.refreshTokenGenerator.generateKey(), issuedAt, expiresAt);
        }
    }

    /**
     * Recognises "public client presenting a refresh token": {@code grant_type=refresh_token} plus a bare
     * {@code client_id}, with no secret anywhere.
     *
     * <p>Deliberately narrow. It returns {@code null} — declining, so the built-in converters get their turn — for
     * any other grant, for a request carrying an {@code Authorization} header, and for one carrying a
     * {@code client_secret}. A confidential client therefore still authenticates exactly as before.
     *
     * <p>Duplicate parameters are rejected rather than taking the first value, as Spring's own converters do:
     * {@code client_id=good&client_id=evil} would otherwise let a caller choose which one the framework reads.
     */
    static final class PublicClientRefreshAuthenticationConverter implements AuthenticationConverter {

        @Override
        public Authentication convert(HttpServletRequest request) {
            if (!AuthorizationGrantType.REFRESH_TOKEN.getValue()
                    .equals(single(request, OAuth2ParameterNames.GRANT_TYPE))) {
                return null;
            }
            if (request.getHeader(HttpHeaders.AUTHORIZATION) != null) {
                return null;   // a confidential client — not ours to handle
            }
            if (single(request, OAuth2ParameterNames.CLIENT_SECRET) != null) {
                return null;   // ditto
            }
            String clientId = single(request, OAuth2ParameterNames.CLIENT_ID);
            if (!StringUtils.hasText(clientId)) {
                return null;
            }
            return new OAuth2ClientAuthenticationToken(clientId, ClientAuthenticationMethod.NONE, null, null);
        }

        /** The parameter's value, or null when absent OR supplied more than once. */
        private static String single(HttpServletRequest request, String name) {
            String[] values = request.getParameterValues(name);
            return (values != null && values.length == 1) ? values[0] : null;
        }
    }

    /**
     * Authenticates what the converter above recognised, and re-verifies it against the registration rather than
     * trusting the request: the client must exist, must actually be registered as public
     * ({@link ClientAuthenticationMethod#NONE}) and must actually hold the {@code refresh_token} grant. Without
     * those checks this would let ANY client id skip authentication on the refresh grant.
     *
     * <p>Returns {@code null} — not an exception — for a token it does not own, so the ProviderManager falls
     * through to Spring's own providers.
     */
    static final class PublicClientRefreshAuthenticationProvider implements AuthenticationProvider {

        private final RegisteredClientRepository registeredClients;

        PublicClientRefreshAuthenticationProvider(RegisteredClientRepository registeredClients) {
            this.registeredClients = registeredClients;
        }

        @Override
        public Authentication authenticate(Authentication authentication) throws AuthenticationException {
            OAuth2ClientAuthenticationToken request = (OAuth2ClientAuthenticationToken) authentication;
            if (!ClientAuthenticationMethod.NONE.equals(request.getClientAuthenticationMethod())
                    || request.isAuthenticated()) {
                return null;
            }
            RegisteredClient client = this.registeredClients.findByClientId(String.valueOf(request.getPrincipal()));
            if (client == null
                    || !client.getClientAuthenticationMethods().contains(ClientAuthenticationMethod.NONE)
                    || !client.getAuthorizationGrantTypes().contains(AuthorizationGrantType.REFRESH_TOKEN)) {
                throw new OAuth2AuthenticationException(OAuth2ErrorCodes.INVALID_CLIENT);
            }
            return new OAuth2ClientAuthenticationToken(client, ClientAuthenticationMethod.NONE, null);
        }

        @Override
        public boolean supports(Class<?> authentication) {
            return OAuth2ClientAuthenticationToken.class.isAssignableFrom(authentication);
        }
    }

    /**
     * Persists authorizations so a refresh token outlives a restart
     * ({@code amoeba.auth.authorization-store=jdbc}).
     *
     * <p>Spring's default is {@code InMemoryOAuth2AuthorizationService}, and leaving it there makes a configured
     * {@code refresh-token-ttl} read as "7 days" while actually meaning "until the next restart". A refresh token
     * is opaque, not a JWT, so the server is the only thing that can vouch for it; keeping that state in memory is
     * what caps its useful life. There is no {@code memory} bean here on purpose — that IS the framework default.
     *
     * <p>Two consequences worth knowing:
     * <ul>
     *   <li>This table also backs the <b>authorization_code</b> exchange, so a missing table breaks LOGIN, not
     *       just refresh — hence the startup probe rather than a first-login stack trace.</li>
     *   <li>Stored rows are revocable for real: {@code POST /oauth2/revoke} invalidates a refresh token, which the
     *       local {@code JwtDecoder} could never do for an access token.</li>
     * </ul>
     */
    @Bean
    @ConditionalOnProperty(prefix = "amoeba.auth", name = "authorization-store", havingValue = "jdbc")
    OAuth2AuthorizationService authorizationService(JdbcOperations jdbc, RegisteredClientRepository clients) {
        try {
            jdbc.execute("SELECT 1 FROM oauth2_authorization WHERE 1 = 0");
        } catch (DataAccessException e) {
            throw new IllegalStateException("""
                    amoeba.auth.authorization-store=jdbc keeps authorizations in the `oauth2_authorization` table, \
                    and it is missing or unreadable. BOTH login and refresh fail without it. There is no tool that \
                    runs DDL — apply it once by hand:
                      mysql -h <host> -P <port> -u <user> -p <db> < src/main/resources/db/oauth2-authorization-schema.sql
                    The script is the one Spring Authorization Server ships, unmodified.""", e);
        }
        return new JdbcOAuth2AuthorizationService(jdbc, clients);
    }

    /**
     * File-backed signing key, so a restart does not invalidate every issued token.
     *
     * <p>The private key is in this file. It is gitignored and must never reach an image layer — but note that
     * "protect the file" is not much of a control here: any deployed module can read it (see the header).
     */
    @Bean
    JWKSource<SecurityContext> jwkSource() throws Exception {
        Path path = Path.of(props.jwksPath());
        RSAKey rsaKey;
        if (Files.exists(path)) {
            rsaKey = (RSAKey) JWKSet.parse(Files.readString(path)).getKeys().get(0);
        } else {
            KeyPairGenerator generator = KeyPairGenerator.getInstance("RSA");
            generator.initialize(2048);
            KeyPair keyPair = generator.generateKeyPair();
            rsaKey = new RSAKey.Builder((RSAPublicKey) keyPair.getPublic())
                    .privateKey((RSAPrivateKey) keyPair.getPrivate())
                    .keyID(UUID.randomUUID().toString())
                    .build();
            if (path.toAbsolutePath().getParent() != null) {
                Files.createDirectories(path.toAbsolutePath().getParent());
            }
            Files.writeString(path, new JWKSet(rsaKey).toString(false)); // false = include the private key
            log.info("Generated a new embedded-auth signing key at {} (kid={})", path, rsaKey.getKeyID());
        }
        return new ImmutableJWKSet<>(new JWKSet(rsaKey));
    }

    /**
     * The Resource Server half verifies against the in-process key instead of fetching its own discovery document
     * over HTTP. Boot's {@code JwtDecoderConfiguration} is annotated {@code @ConditionalOnMissingBean(JwtDecoder)}
     * at the class level (verified against the 3.5.16 bytecode), so declaring this bean backs the whole thing off
     * — no self-call, no startup ordering, no dependence on the advertised port being reachable from inside.
     *
     * <p>{@code OAuth2AuthorizationServerConfiguration.jwtDecoder} validates the SIGNATURE only, so the standard
     * validators (exp/nbf) plus the issuer check are attached explicitly. Skipping this would accept a
     * correctly-signed token with any {@code iss}.
     */
    @Bean
    JwtDecoder jwtDecoder(JWKSource<SecurityContext> jwkSource) {
        NimbusJwtDecoder decoder = (NimbusJwtDecoder) OAuth2AuthorizationServerConfiguration.jwtDecoder(jwkSource);
        decoder.setJwtValidator(JwtValidators.createDefaultWithIssuer(issuer));
        return decoder;
    }
}
