// [CAPABILITY: custom MCP tool] amoeba.list_tables — which tables exist in the database modules use.
//
// Before this tool, the only way an agent could see the schema was to deploy a throwaway module that queried
// information_schema, read its output, and uninstall it again. This answers the same question without a deploy,
// without SQL, and on the mcp.read scope.
//
// `pattern` matches the COMMENT as well as the name on purpose: agents are usually handed a concept ("회사",
// "employee") rather than a table name, and in a Korean schema the comment is where that concept is written.
package {{PKG}}.db;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.node.ArrayNode;
import com.fasterxml.jackson.databind.node.ObjectNode;

import {{PKG}}.db.DbMetadataReader.Location;
import {{PKG}}.db.DbMetadataReader.TableList;
import {{PKG}}.db.DbMetadataReader.TableSummary;
import {{PKG}}.db.DbMetadataReader.TableType;

import org.htcom.protean.mcp.McpCallContext;
import org.htcom.protean.mcp.McpTool;
import org.htcom.protean.mcp.McpToolAnnotations;
import org.htcom.protean.mcp.McpToolResult;
import org.htcom.protean.mcp.ModuleActionAuthorizer;

import org.springframework.stereotype.Component;

import java.sql.SQLException;
import java.util.List;
import java.util.Locale;
import java.util.Set;

@Component
public class ListTablesTool implements McpTool {

    private static final int DEFAULT_LIMIT = 100;
    private static final int MAX_LIMIT = 500;

    private final ObjectMapper mapper;
    private final DbMetadataReader reader;

    public ListTablesTool(ObjectMapper mapper, DbMetadataReader reader) {
        this.mapper = mapper;
        this.reader = reader;
    }

    @Override
    public String name() {
        return "amoeba.list_tables";
    }

    @Override
    public String title() {
        return "List Database Tables";
    }

    @Override
    public String description() {
        return "Lists the tables and views of the database this server's modules use (the host DataSource's "
                + "current database only), with their comments. Takes no SQL and returns no rows. 'pattern' keeps "
                + "tables whose NAME or COMMENT contains it (case-insensitive), so a concept word such as '회사' "
                + "finds tables commented with it. Call amoeba.describe_table on a listed name for its columns, "
                + "keys and indexes — instead of deploying a temporary module to query information_schema.";
    }

    /** A pure read. Leaving this at the SPI's CUSTOM default would demand mcp.admin. */
    @Override
    public ModuleActionAuthorizer.ModuleAction action() {
        return ModuleActionAuthorizer.ModuleAction.READ;
    }

    /** No module is involved; the authorizer sees a null target, as it does for protean.list_modules. */
    @Override
    public String targetModuleId(JsonNode arguments) {
        return null;
    }

    @Override
    public McpToolAnnotations annotations() {
        return McpToolAnnotations.readOnly();
    }

    /** Every argument is optional, so {@code required} is omitted — an empty array is invalid in draft-04. */
    @Override
    public ObjectNode inputSchema() {
        ObjectNode schema = mapper.createObjectNode();
        schema.put("type", "object");
        schema.put("additionalProperties", false);
        ObjectNode p = schema.putObject("properties");
        p.putObject("pattern").put("type", "string")
                .put("maxLength", DbToolSchemas.MAX_NAME_LENGTH)
                .put("description", "Optional. Case-insensitive substring of the table name or its comment. "
                        + "Plain text, not SQL LIKE — '_' and '%' match themselves.");
        DbToolSchemas.putTypes(p);
        p.putObject("limit").put("type", "integer")
                .put("description", "Maximum tables to return (default " + DEFAULT_LIMIT + ", max " + MAX_LIMIT
                        + ", 0 = all).");
        p.putObject("cursor").put("type", "string")
                .put("description", "nextCursor from a previous response, to continue listing.");
        return schema;
    }

    @Override
    public ObjectNode outputSchema() {
        ObjectNode schema = mapper.createObjectNode();
        schema.put("type", "object");
        ObjectNode p = schema.putObject("properties");
        DbToolSchemas.putLocation(p);
        p.putObject("totalCount").put("type", "integer")
                .put("description", "Tables matching the filters, before paging.");

        ObjectNode tables = p.putObject("tables");
        tables.put("type", "array");
        ObjectNode item = tables.putObject("items");
        item.put("type", "object");
        ObjectNode ip = item.putObject("properties");
        ip.putObject("name").put("type", "string");
        DbToolSchemas.putTableType(ip);
        ip.putObject("comment").put("type", "string");
        item.putArray("required").add("name").add("type");

        p.putObject("nextCursor").put("type", "string");

        // database/schema/nextCursor are conditional and therefore NOT required — see DbToolSchemas.putLocation.
        schema.putArray("required").add("totalCount").add("tables");
        return schema;
    }

    @Override
    public McpToolResult call(JsonNode arguments, McpCallContext ctx) {
        JsonNode args = arguments == null ? mapper.missingNode() : arguments;
        String pattern = DbToolSchemas.text(args, "pattern");
        Set<TableType> types = DbToolSchemas.parseTypes(args);
        int limit = DbToolSchemas.clampLimit(args.path("limit"), DEFAULT_LIMIT, MAX_LIMIT);
        int offset = DbToolSchemas.decodeCursor(args.path("cursor").asText(null));

        TableList list;
        try {
            list = reader.listTables();
        } catch (SQLException e) {
            return McpToolResult.error("database metadata read failed: [" + e.getSQLState() + "] "
                    + e.getMessage());
        }

        String needle = pattern == null ? null : pattern.toLowerCase(Locale.ROOT);
        List<TableSummary> matched = list.tables().stream()
                .filter(t -> types.contains(t.type()))
                .filter(t -> needle == null || contains(t.name(), needle) || contains(t.comment(), needle))
                .toList();

        int total = matched.size();
        int from = Math.min(offset, total);
        int to = limit >= total ? total : Math.min(from + limit, total);
        List<TableSummary> page = matched.subList(from, to);

        Location location = list.location();
        ObjectNode out = mapper.createObjectNode();
        if (location.database() != null) {
            out.put("database", location.database());
        }
        if (location.schema() != null) {
            out.put("schema", location.schema());
        }
        out.put("totalCount", total);
        ArrayNode tables = out.putArray("tables");
        for (TableSummary t : page) {
            ObjectNode node = tables.addObject();
            node.put("name", t.name());
            node.put("type", t.type().wire());
            if (t.comment() != null) {
                node.put("comment", t.comment());
            }
        }
        if (to < total) {
            out.put("nextCursor", DbToolSchemas.encodeCursor(to));
        }
        return McpToolResult.ok(renderText(location, page, total, to < total), out);
    }

    private static boolean contains(String haystack, String lowerNeedle) {
        return haystack != null && haystack.toLowerCase(Locale.ROOT).contains(lowerNeedle);
    }

    private static String renderText(Location location, List<TableSummary> page, int total, boolean more) {
        StringBuilder sb = new StringBuilder();
        sb.append("Database ").append(where(location)).append(" — ")
                .append(page.size()).append(" of ").append(total).append(" table(s)");
        if (more) {
            sb.append(", more available");
        }
        sb.append('\n');
        int width = page.stream().mapToInt(t -> t.name().length()).max().orElse(0);
        for (TableSummary t : page) {
            sb.append("  ").append(pad(t.name(), width)).append("  ").append(pad(t.type().wire(), 5));
            if (t.comment() != null) {
                sb.append("  ").append(t.comment());
            }
            sb.append('\n');
        }
        return sb.toString();
    }

    static String where(Location location) {
        if (location.database() != null && location.schema() != null) {
            return location.database() + "." + location.schema();
        }
        if (location.database() != null) {
            return location.database();
        }
        return location.schema() == null ? "(current)" : location.schema();
    }

    private static String pad(String s, int width) {
        return s.length() >= width ? s : s + " ".repeat(width - s.length());
    }
}
