// LiveVendorMetadataContract against a real PostgreSQL through pgjdbc.
//
//   docker run -d --name dbtools-pg -e POSTGRES_PASSWORD=pw -e POSTGRES_DB=probe -p 15432:5432 postgres:17
//   DB_TOOLS_TEST_POSTGRES_URL='jdbc:postgresql://127.0.0.1:15432/probe' DB_TOOLS_TEST_POSTGRES_USER=postgres \
//     DB_TOOLS_TEST_POSTGRES_PASSWORD=pw ./gradlew test --tests '*LivePostgresMetadataTest'
//   docker rm -f dbtools-pg
package {{PKG}}.db;

import com.fasterxml.jackson.databind.JsonNode;

import org.htcom.protean.mcp.McpToolResult;
import org.junit.jupiter.api.Test;

import java.sql.Connection;
import java.sql.SQLException;
import java.util.List;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertTrue;

class LivePostgresMetadataTest extends LiveVendorMetadataContract {

    @Override
    String envPrefix() {
        return "DB_TOOLS_TEST_POSTGRES";
    }

    @Override
    DbVendor vendor() {
        return DbVendor.POSTGRESQL;
    }

    @Override
    String[] createProbe() {
        return new String[] {
                "CREATE TABLE " + PARENT + " (id BIGINT GENERATED BY DEFAULT AS IDENTITY,"
                        + " code VARCHAR(20) NOT NULL, amount NUMERIC(12,2),"
                        + " CONSTRAINT pk_zz_probe_parent PRIMARY KEY (id),"
                        + " CONSTRAINT uk_zz_probe_code UNIQUE (code))",
                "COMMENT ON TABLE " + PARENT + " IS '" + PARENT_COMMENT + "'",
                "COMMENT ON COLUMN " + PARENT + ".id IS '" + ID_COMMENT + "'",
                "CREATE TABLE " + CHILD + " (id BIGINT NOT NULL, parent_id BIGINT NOT NULL,"
                        + " CONSTRAINT pk_zz_probe_child PRIMARY KEY (id),"
                        + " CONSTRAINT fk_zz_probe_parent FOREIGN KEY (parent_id) REFERENCES " + PARENT
                        + " (id) ON DELETE CASCADE)",
                "COMMENT ON TABLE " + CHILD + " IS '" + CHILD_COMMENT + "'",
                "CREATE VIEW " + VIEW + " AS SELECT id, code FROM " + PARENT,
        };
    }

    @Override
    String[] dropProbe() {
        return new String[] {"DROP VIEW IF EXISTS " + VIEW, "DROP TABLE IF EXISTS " + CHILD,
                "DROP TABLE IF EXISTS " + PARENT};
    }

    @Override
    String[] refusedSystemLocation() {
        return new String[] {"schema", "pg_catalog"};
    }

    @Test
    void identityColumnsAreAutoIncrement() {
        assertTrue(column(describe(PARENT), "id").path("autoIncrement").asBoolean());
    }

    /**
     * pgjdbc lists every database on the server, but the connection cannot leave its own: offering the others (or
     * template1) would end in "0 tables" for a database nobody read. Only the current one is offered or opened.
     */
    @Test
    void onlyTheConnectedDatabaseIsOfferedOrOpened() throws SQLException {
        String current;
        try (Connection conn = database.getConnection()) {
            current = conn.getCatalog();
        }
        ListTablesTool tool = new ListTablesTool(mapper, new DbMetadataReader(database));
        JsonNode listed = tool.call(mapper.createObjectNode(), null).structured();
        assertEquals(List.of(current), strings(listed.path("databases")), listed.toString());

        McpToolResult other = tool.call(mapper.createObjectNode().put("database", "postgres"), null);
        assertTrue(other.isError() && other.text().contains("cannot open another database"), other.text());
    }
}
