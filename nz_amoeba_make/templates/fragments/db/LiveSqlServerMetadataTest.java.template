// LiveVendorMetadataContract against a real SQL Server through mssql-jdbc — plus what only SQL Server does: comments
// stored as MS_Description extended properties (VendorComments), `int identity` type names, (max) sizes, the system
// databases, and another database opening at dbo.
//
// The probe needs a database of its own (an empty server has only the system ones), so prepareUrl creates
// zz_dbtools_probe and points the tools at it; the cross-database test adds zz_dbtools_probe_other.
//
//   docker run -d --name dbtools-mssql -e ACCEPT_EULA=Y -e 'MSSQL_SA_PASSWORD=Probe_pw1!' -p 11433:1433 \
//     mcr.microsoft.com/mssql/server:2022-latest
//   DB_TOOLS_TEST_SQLSERVER_URL='jdbc:sqlserver://127.0.0.1:11433;encrypt=false' DB_TOOLS_TEST_SQLSERVER_USER=sa \
//     DB_TOOLS_TEST_SQLSERVER_PASSWORD='Probe_pw1!' ./gradlew test --tests '*LiveSqlServerMetadataTest'
//   docker rm -f dbtools-mssql
package {{PKG}}.db;

import com.fasterxml.jackson.databind.JsonNode;

import org.junit.jupiter.api.Test;
import org.springframework.jdbc.datasource.DriverManagerDataSource;

import java.sql.SQLException;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertTrue;

class LiveSqlServerMetadataTest extends LiveVendorMetadataContract {

    private static final String PROBE_DB = "zz_dbtools_probe";
    private static final String OTHER_DB = "zz_dbtools_probe_other";

    @Override
    String envPrefix() {
        return "DB_TOOLS_TEST_SQLSERVER";
    }

    @Override
    DbVendor vendor() {
        return DbVendor.SQLSERVER;
    }

    @Override
    String prepareUrl(String url, String user, String password) throws SQLException {
        DbFixtures.exec(new DriverManagerDataSource(url, user, password),
                "IF DB_ID('" + PROBE_DB + "') IS NULL CREATE DATABASE " + PROBE_DB,
                "IF DB_ID('" + OTHER_DB + "') IS NULL CREATE DATABASE " + OTHER_DB);
        return url + ";databaseName=" + PROBE_DB;
    }

    @Override
    String[] createProbe() {
        return new String[] {
                "CREATE TABLE " + PARENT + " (id BIGINT IDENTITY(1,1) NOT NULL, code VARCHAR(20) NOT NULL,"
                        + " note NVARCHAR(MAX) NULL,"
                        + " CONSTRAINT pk_zz_probe_parent PRIMARY KEY (id),"
                        + " CONSTRAINT uk_zz_probe_code UNIQUE (code))",
                msDescription("TABLE", PARENT, null, PARENT_COMMENT),
                msDescription("TABLE", PARENT, "id", ID_COMMENT),
                "CREATE TABLE " + CHILD + " (id BIGINT NOT NULL, parent_id BIGINT NOT NULL,"
                        + " CONSTRAINT pk_zz_probe_child PRIMARY KEY (id),"
                        + " CONSTRAINT fk_zz_probe_parent FOREIGN KEY (parent_id) REFERENCES " + PARENT
                        + " (id) ON DELETE CASCADE)",
                msDescription("TABLE", CHILD, null, CHILD_COMMENT),
                "CREATE VIEW " + VIEW + " AS SELECT id, code FROM " + PARENT,
                "CREATE TABLE " + OTHER_DB + ".dbo.ledger (id BIGINT NOT NULL PRIMARY KEY)",
                "EXEC " + OTHER_DB + ".sys.sp_addextendedproperty 'MS_Description', N'다른 DB 의 원장',"
                        + " 'SCHEMA', 'dbo', 'TABLE', 'ledger'",
        };
    }

    private static String msDescription(String kind, String table, String column, String text) {
        return "EXEC sp_addextendedproperty 'MS_Description', N'" + text + "', 'SCHEMA', 'dbo', '" + kind + "', '"
                + table + "'" + (column == null ? "" : ", 'COLUMN', '" + column + "'");
    }

    @Override
    String[] dropProbe() {
        return new String[] {"DROP VIEW IF EXISTS " + VIEW, "DROP TABLE IF EXISTS " + CHILD,
                "DROP TABLE IF EXISTS " + PARENT, "DROP TABLE IF EXISTS " + OTHER_DB + ".dbo.ledger"};
    }

    @Override
    String[] refusedSystemLocation() {
        return new String[] {"database", "master"};
    }

    @Test
    void identityAndMaxReadAsDeclared() {
        JsonNode parent = describe(PARENT);
        JsonNode id = column(parent, "id");
        assertEquals("bigint", id.path("type").asText(), parent.toString());
        assertTrue(id.path("autoIncrement").asBoolean(), parent.toString());
        assertEquals("nvarchar(max)", column(parent, "note").path("type").asText(), parent.toString());
    }

    @Test
    void anotherDatabaseOpensAtDboWithItsComments() {
        ListTablesTool tool = new ListTablesTool(mapper, new DbMetadataReader(database));
        JsonNode s = tool.call(mapper.createObjectNode().put("database", OTHER_DB), null).structured();
        assertEquals(OTHER_DB, s.path("database").asText(), s.toString());
        assertEquals("dbo", s.path("schema").asText(), s.toString());
        assertEquals(1, s.path("totalCount").asInt(), "only dbo's tables, not every schema's: " + s);
        assertEquals("다른 DB 의 원장", s.path("tables").get(0).path("comment").asText(), s.toString());
    }
}
