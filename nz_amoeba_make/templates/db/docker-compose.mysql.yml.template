# Local MySQL for the {{NAME}} sample. Database/user/password match application.yml ({{DB}} / {{DB}} / {{PW}}).
#   docker compose up -d   |   docker compose down   |   docker compose down -v  (wipe)
# ★ Pin the project name. At deployment-infra level >= container this file is written next to the APP's
#   docker-compose.yml as docker-compose.db.yml; without a name both would share the directory's project and
#   `docker compose down` on one would report the other's containers as orphans.
name: {{NAME_KEBAB}}-db

services:
  mysql:
    image: mysql:8.4
    container_name: protean-{{NAME}}-mysql
    ports:
      # Loopback only. A bare "3306:3306" binds 0.0.0.0 and offers this demo database — and its demo password —
      # to the whole network. Only the app on this host needs it.
      - "127.0.0.1:3306:3306"
    environment:
      # No fixed root password: the image generates one and prints it once to the container log
      # ("GENERATED ROOT PASSWORD"). Nothing here uses root — the healthcheck and the app use the account below.
      MYSQL_RANDOM_ROOT_PASSWORD: "yes"
      MYSQL_DATABASE: {{DB}}
      MYSQL_USER: {{DB}}
      MYSQL_PASSWORD: {{PW}}
    volumes:
      - protean-{{NAME}}-mysql-data:/var/lib/mysql
      - ./init:/docker-entrypoint-initdb.d:ro   # *.sql runs on FIRST boot of a fresh volume
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-u{{DB}}", "-p{{PW}}"]
      interval: 5s
      timeout: 5s
      retries: 10

volumes:
  protean-{{NAME}}-mysql-data:
