// [CAPABILITY: secured MCP / OAuth metadata] Only when MCP is exposed beyond a trusted local demo.
// protean does NOT implement authentication — it delegates to your Spring Security. Requires:
//   implementation 'org.springframework.boot:spring-boot-starter-security'
//   implementation 'org.springframework.boot:spring-boot-starter-oauth2-resource-server'
// and spring.security.oauth2.resourceserver.jwt.issuer-uri (or jwk-set-uri) in application.yml.
//
// TWO CHAINS, on purpose:
//   #1 /platform/** — the CONTROL plane. Bearer token required; scope-gated per method (see below).
//   #2 everything else — the SERVICE plane. Deployed module routes and the public discovery document.
// They are separate so service-plane auth can be added later without touching #1.
//
// WHY THE METHOD GATING IN CHAIN #1: protean calls ModuleActionAuthorizer from exactly one place (McpDispatcher),
// which means the /platform/** admin REST controllers are a SECOND deploy path that never reaches that bean.
// `POST /platform/modules` installs a module without passing any authorizer policy. So module-mutating admin REST
// is raised to the admin scope here, in the filter chain — the only layer that sees it. Promotion gates still run
// on every deploy path, but gates check code, not who asked.
//
// WHY THE CONSTRUCTOR CHECK: only the UNSET case stops the app on its own — Boot's jwtDecoderByIssuerUri resolves
// issuer-uri through the Environment during condition evaluation and rejects the unresolvable ${...} placeholder.
// An EMPTY value and a MALFORMED one (no scheme) both get past Spring, leaving an RCE surface with a decoder that
// can never verify anything. So those two are rejected here, loudly, with the fix in the message.
//
// WHY AUDIENCE IS CHECKED TOO: the issuer is SHARED. One Authorization Server mints tokens for every resource
// server it fronts, so `iss` proves only "that AS signed it" — not "this token was meant for us". Audience is what
// makes a token ours. Validation itself is Boot's (spring...jwt.audiences, bound to
// protean.mcp.authorization.resource in application.yml) so the decoder stays the lazy SupplierJwtDecoder; what
// Boot will NOT do is complain when the list is empty — it just stops checking. That silence is the whole risk,
// so a blank value is rejected here.
//
// WHY THE 401 NAMES ITS METADATA: RFC 9728 §3.1 puts the document of a resource WITH A PATH at the path-appended
// address (/.well-known/oauth-protected-resource/platform/mcp), and §3.3 makes a client REJECT a document whose
// `resource` differs from the identifier it built that URL from. protean publishes the document only at the ROOT,
// with resource = .../platform/mcp. A strict client (VS Code's built-in MCP client) therefore gets 404 at the
// path-appended address, rejects the root one (it expects the bare origin there), gives up on discovery, treats
// THIS app as the Authorization Server and never reaches the real one. Lenient clients (mcp-remote) skip §3.3,
// which is why nothing shows until VS Code. Two nested classes close it: McpResourceMetadata serves protean's own
// document at the path-appended address, and McpAuthenticationEntryPoint adds resource_metadata="..." to every
// /platform/** 401 (RFC 9728 §5.1 — a MUST in the MCP authorization spec). They are nested, not fragments of their
// own, because they exist only for chain #1 and must ship and rename together with it.
package {{PKG}};

import java.net.URI;
import java.util.Map;

import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;

import org.htcom.protean.mcp.transport.McpProtectedResourceMetadataController;

import org.springframework.beans.factory.ObjectProvider;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.core.annotation.Order;
import org.springframework.http.HttpHeaders;
import org.springframework.http.HttpMethod;
import org.springframework.http.ResponseEntity;
import org.springframework.security.config.Customizer;
import org.springframework.security.config.annotation.web.builders.HttpSecurity;
import org.springframework.security.config.http.SessionCreationPolicy;
import org.springframework.security.core.AuthenticationException;
import org.springframework.security.oauth2.server.resource.web.BearerTokenAuthenticationEntryPoint;
import org.springframework.security.web.AuthenticationEntryPoint;
import org.springframework.security.web.SecurityFilterChain;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RestController;

@Configuration
public class SecurityConfig {

    // Authorities as Spring renders bearer scopes: scope "mcp.read" -> authority "SCOPE_mcp.read".
    // Advertise the same names in protean.mcp.authorization.scopes-supported, and map them to actions in the
    // ModuleActionAuthorizer bean (the `authorizer` capability's fragment, whatever the generator named it).
    // NOTE: these are OAUTH scopes — nothing to do with protean.worker.db.scopes (DB tenants).
    private static final String READ = "SCOPE_mcp.read";
    private static final String WRITE = "SCOPE_mcp.write";
    private static final String ADMIN = "SCOPE_mcp.admin";

    /**
     * Reads the PROPERTY, not the {@code OAUTH_ISSUER_URI} env var: what matters is the value the Resource Server
     * actually uses, and setting {@code SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI} directly is a
     * legitimate route that must pass. The empty {@code :} fallback keeps the diagnostic here instead of depending
     * on which placeholder exception Spring raises first.
     *
     * <p>A <i>well-formed but wrong or unreachable</i> issuer is deliberately NOT caught: Boot returns a
     * {@code SupplierJwtDecoder} that defers the discovery fetch to the first {@code decode(String)}, so the
     * Authorization Server need not be reachable at startup. Checking it here would impose a startup ordering
     * constraint that Spring intentionally avoids — such a value starts fine and 401s on every request instead.
     */
    SecurityConfig(@Value("${spring.security.oauth2.resourceserver.jwt.issuer-uri:}") String issuerUri,
            @Value("${spring.security.oauth2.resourceserver.jwt.audiences:}") String audiences) {
        if (issuerUri.isBlank() || issuerUri.contains("${") || !issuerUri.startsWith("http")) {
            throw new IllegalStateException("""
                    No usable OAuth2 issuer is configured, so the MCP control plane (/platform/**) cannot be \
                    protected. /platform/mcp is a remote code execution surface, so this app refuses to start.

                      export OAUTH_ISSUER_URI=https://<your-as-host>/realms/<realm>

                    The value must be the Authorization Server's issuer identifier — the exact 'iss' claim string \
                    its tokens carry, not the token endpoint, JWKS URL, or login page. Confirm it with:
                      curl -s <candidate>/.well-known/openid-configuration | jq -r .issuer

                    See README section 'Security'. Resolved value was: '""" + issuerUri + "'");
        }
        if (audiences.isBlank() || audiences.contains("${")) {
            throw new IllegalStateException("""
                    No audience is configured, so this Resource Server would accept ANY token the issuer signed                     — including one obtained for a different resource entirely. /platform/mcp is a remote code                     execution surface, so this app refuses to start.

                    application.yml binds the audience to the resource identifier:
                      spring.security.oauth2.resourceserver.jwt.audiences: ${protean.mcp.authorization.resource:}

                    So this is blank because protean.mcp.authorization.resource is blank. Set it — and set the                     Authorization Server's audience claim to the SAME string. A mismatch is not silent: every                     request 401s with 'invalid_token'. Check what this app advertises with:
                      curl -s http://<this-host>:<port>/.well-known/oauth-protected-resource | jq -r .resource

                    Resolved value was: '""" + audiences + "'");
        }
    }

    /**
     * Control plane. Scoped to {@code /platform/**} so nothing else in the app is affected.
     *
     * <p>CSRF off and sessions stateless because every caller here is a bearer-token client (MCP agents, operators'
     * scripts) — there is no browser form to protect. Rules are evaluated in declaration order.
     *
     * <p>The 401 carries {@code resource_metadata} ({@link McpAuthenticationEntryPoint}) — that is how an MCP client
     * finds the protected-resource document and, through it, the Authorization Server.
     */
    @Bean
    @Order(1)
    SecurityFilterChain platformSecurityFilterChain(
            HttpSecurity http,
            @Value("${protean.mcp.authorization.resource:}") String resource) throws Exception {
        http
            .securityMatcher("/platform/**")
            .csrf(csrf -> csrf.disable())
            .sessionManagement(s -> s.sessionCreationPolicy(SessionCreationPolicy.STATELESS))
            .authorizeHttpRequests(auth -> auth
                // (1) MCP transport — coarse gate only; the ModuleActionAuthorizer bean decides per action.
                .requestMatchers("/platform/mcp", "/platform/mcp/**").hasAnyAuthority(READ, WRITE, ADMIN)
                // (2) admin REST reads — /platform/modules, /platform/trace/*, /platform/runtimes, ...
                .requestMatchers(HttpMethod.GET, "/platform/**").hasAnyAuthority(READ, WRITE)
                // (3) MODULE-MUTATING admin REST — raised above plain deploy rights, because this path bypasses
                // ModuleActionAuthorizer entirely (see the header). An agent holding mcp.write cannot reach it;
                // an operator with mcp.admin still can. Declared before the general write rules below.
                .requestMatchers(HttpMethod.POST, "/platform/modules", "/platform/modules/**").hasAuthority(ADMIN)
                .requestMatchers(HttpMethod.PUT, "/platform/modules", "/platform/modules/**").hasAuthority(ADMIN)
                .requestMatchers(HttpMethod.PATCH, "/platform/modules", "/platform/modules/**").hasAuthority(ADMIN)
                .requestMatchers(HttpMethod.DELETE, "/platform/modules", "/platform/modules/**").hasAuthority(ADMIN)
                // (4) remaining admin REST writes — config, shared libs, scopes.
                .requestMatchers(HttpMethod.POST, "/platform/**").hasAuthority(WRITE)
                .requestMatchers(HttpMethod.PUT, "/platform/**").hasAuthority(WRITE)
                .requestMatchers(HttpMethod.PATCH, "/platform/**").hasAuthority(WRITE)
                .requestMatchers(HttpMethod.DELETE, "/platform/**").hasAuthority(WRITE)
                // (5) anything else that reached this chain still needs a valid token.
                .anyRequest().authenticated())
            // Missing/invalid token -> 401 + WWW-Authenticate: Bearer resource_metadata="...", emitted by the Resource
            // Server. One entry point covers both cases: the chain's default (no token) and the bearer filter's
            // failure handler (bad token).
            .oauth2ResourceServer(oauth2 -> oauth2
                .jwt(Customizer.withDefaults())
                .authenticationEntryPoint(new McpAuthenticationEntryPoint(resource)));
        return http.build();
    }

    /**
     * Service plane + discovery. Everything that did not match chain #1 lands here.
     *
     * <p>Deployed modules declare their own routes at the root, so this chain cannot use a positive matcher — it is
     * the fallback by design. {@code oauth2ResourceServer} is deliberately NOT applied: service traffic should not
     * even attempt token parsing while the plane is open. {@code /.well-known/oauth-protected-resource} (published
     * by protean when {@code protean.mcp.authorization.resource} is set) must be reachable unauthenticated and
     * reaches it here.
     *
     * <p>THIS is the seam to edit when the service plane gains its own authentication.
     *
     * <p><b>STATELESS is unconditional.</b> This app is a Resource Server only — token issuance belongs to an
     * EXTERNAL Authorization Server (the one named by {@code OAUTH_ISSUER_URI}), so there is no login here, no
     * session to keep, and no reason for the policy to be conditional. {@code ResourceServerOnlyTest} pins the
     * absence of the form: a login form reappearing means the service plane silently became stateful again.
     *
     * <p>CSRF stays disabled — module routes may be POST and would break otherwise. With {@code permitAll} and no
     * session there is nothing for CSRF to protect here.
     */
    @Bean
    @Order(2)
    SecurityFilterChain serviceSecurityFilterChain(HttpSecurity http) throws Exception {
        http
            // Modules may declare POST routes; with permitAll and no session, CSRF has nothing to protect.
            .csrf(csrf -> csrf.disable())
            .sessionManagement(s -> s.sessionCreationPolicy(SessionCreationPolicy.STATELESS))
            .authorizeHttpRequests(auth -> auth.anyRequest().permitAll());

        return http.build();
    }

    /**
     * The protected-resource document at the address RFC 9728 derives from this resource — the PATH-APPENDED one
     * ({@value #METADATA_PATH}). The body is protean's own document, returned as-is: one source, so the two addresses
     * cannot drift. The root one stays for lenient clients (ResourceServerOnlyTest pins both).
     *
     * <p>Same activation as protean's controller: it exists only when protean.mcp.authorization.resource is set.
     * It reaches the unauthenticated chain #2 because its path is not under /platform/**.
     */
    @RestController
    @ConditionalOnProperty(name = "protean.mcp.authorization.resource")
    static class McpResourceMetadata {

        static final String WELL_KNOWN = "/.well-known/oauth-protected-resource";

        /** protean's MCP transport path — fixed by the library, so the mapping below can be a constant. */
        static final String MCP_PATH = "/platform/mcp";

        static final String METADATA_PATH = WELL_KNOWN + MCP_PATH;

        private final ObjectProvider<McpProtectedResourceMetadataController> protean;

        /**
         * Refuses to start when the configured resource is not {@code …/platform/mcp}: the mapping is a constant,
         * and a document served at an address that does not derive from its own {@code resource} is exactly the
         * §3.3 mismatch this class exists to remove.
         */
        McpResourceMetadata(ObjectProvider<McpProtectedResourceMetadataController> protean,
                            @Value("${protean.mcp.authorization.resource}") String resource) {
            String path = URI.create(resource).getRawPath();
            if (!MCP_PATH.equals(path)) {
                throw new IllegalStateException("protean.mcp.authorization.resource must end in " + MCP_PATH
                        + " (the MCP transport path) so its RFC 9728 metadata address " + METADATA_PATH
                        + " derives from it. Resolved value was: '" + resource + "'");
            }
            this.protean = protean;
        }

        @GetMapping(METADATA_PATH)
        ResponseEntity<Map<String, Object>> metadata() {
            McpProtectedResourceMetadataController source = this.protean.getIfAvailable();
            return (source == null) ? ResponseEntity.notFound().build() : ResponseEntity.ok(source.metadata());
        }

        /**
         * The RFC 9728 §3.1 metadata URL for {@code resource}: its origin + {@value #WELL_KNOWN} + its path.
         * {@code http://h:8080/platform/mcp} → {@code http://h:8080/.well-known/oauth-protected-resource/platform/mcp}.
         */
        static String metadataUrl(String resource) {
            URI uri = URI.create(resource);
            String path = (uri.getRawPath() == null) ? "" : uri.getRawPath();
            return uri.getScheme() + "://" + uri.getRawAuthority() + WELL_KNOWN + path;
        }
    }

    /**
     * Spring's Bearer challenge plus the {@code resource_metadata} parameter (RFC 9728 §5.1).
     *
     * <p>Wraps BearerTokenAuthenticationEntryPoint instead of re-implementing it, so {@code error="invalid_token"}
     * and friends keep coming from Spring; this only appends one parameter. The delegate sets a header and a status
     * and writes no body, so the response is not committed yet and the header can still be replaced.
     */
    static final class McpAuthenticationEntryPoint implements AuthenticationEntryPoint {

        private final BearerTokenAuthenticationEntryPoint delegate = new BearerTokenAuthenticationEntryPoint();

        /** Null when no resource is configured — then this is exactly Spring's entry point. */
        private final String resourceMetadata;

        McpAuthenticationEntryPoint(String resource) {
            this.resourceMetadata = (resource == null || resource.isBlank())
                    ? null
                    : McpResourceMetadata.metadataUrl(resource);
        }

        @Override
        public void commence(HttpServletRequest request, HttpServletResponse response,
                             AuthenticationException authException) {
            this.delegate.commence(request, response, authException);
            if (this.resourceMetadata == null) {
                return;
            }
            String param = "resource_metadata=\"" + this.resourceMetadata + "\"";
            String challenge = response.getHeader(HttpHeaders.WWW_AUTHENTICATE);
            // "Bearer" alone has no parameter list yet; anything longer already does and takes a comma.
            String value = (challenge == null || challenge.equals("Bearer"))
                    ? "Bearer " + param
                    : challenge + ", " + param;
            response.setHeader(HttpHeaders.WWW_AUTHENTICATE, value);
        }
    }
}
