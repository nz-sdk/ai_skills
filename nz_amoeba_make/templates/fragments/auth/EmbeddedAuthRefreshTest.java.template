// [CAPABILITY: embedded Authorization Server — refresh tokens] Emitted only when
// amoeba.auth.refresh-token-enabled=true (see the `when:` on this file in protean-options.yaml).
//
// WHY A SEPARATE FILE FROM EmbeddedAuthFlowTest. Refresh is a property, so the CODE ships either way and is gated
// by @ConditionalOnProperty — but a test cannot be gated that way, it would just fail. fragment_bundle `when:`
// works on whole files, so the refresh assertions live here.
//
// WHAT THIS EXISTS TO CATCH. Spring refuses refresh tokens to a public client in two places, and
// EmbeddedAuthServerConfig opens both. Each of the three tests below pins one thing that silently regresses:
//   · issuance          — the tokenGenerator bean is present and actually overrides the guard
//   · rotation          — reuseRefreshTokens(false), and a replayed token is refused
//   · the customizer    — audience lock + per-user scope narrowing SURVIVE a refresh
// The last one is the subtle one: a custom OAuth2TokenGenerator takes over the wiring of the JwtCustomizer, so
// forgetting setJwtCustomizer leaves initial issuance perfect while every RENEWED token loses its audience lock
// and hands a read-only user full scope.
package {{PKG}}.auth;

import org.junit.jupiter.api.AfterAll;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.test.context.DynamicPropertyRegistry;
import org.springframework.test.context.DynamicPropertySource;

import java.net.URI;
import java.net.URLEncoder;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.security.MessageDigest;
import java.util.Base64;
import java.util.LinkedHashMap;
import java.util.Map;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertNotEquals;
import static org.junit.jupiter.api.Assertions.assertNotNull;
import static org.junit.jupiter.api.Assertions.assertTrue;

@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.DEFINED_PORT)
class EmbeddedAuthRefreshTest {

    // A different port from EmbeddedAuthFlowTest: both bind for real, and Gradle may run them in either order.
    static final int PORT = 18081;
    static final String BASE = "http://localhost:" + PORT;
    static final String RESOURCE_ID = BASE + "/platform/mcp";
    static final String REDIRECT_URI = "http://127.0.0.1:3334/oauth/callback";
    static final String CLIENT_ID = "nz-mcp-agent";

    static final Path keyFile = Path.of("build", "test-refresh-jwks-" + System.nanoTime() + ".json");
    static final Path storeDir = Path.of("build", "test-refresh-store-" + System.nanoTime());

    @DynamicPropertySource
    static void props(DynamicPropertyRegistry r) {
        r.add("server.port", () -> PORT);
        r.add("amoeba.auth.enabled", () -> true);
        r.add("amoeba.auth.refresh-token-enabled", () -> true);
        r.add("amoeba.auth.jwks-path", () -> keyFile.toString());
        r.add("amoeba.auth.mcp-redirect-uris", () -> REDIRECT_URI);
        r.add("spring.security.oauth2.resourceserver.jwt.issuer-uri", () -> BASE);
        r.add("protean.mcp.authorization.resource", () -> RESOURCE_ID);
        r.add("protean.module-store.dir", storeDir::toString);
        r.add("protean.module-store.backend", () -> "filesystem");

        // ★ Exercise the JDBC store, not the in-memory default — the row mapper is where the sharp edges are
        // (the allowlisted ObjectMapper, and the registered-client id being resolvable). In-memory would pass
        // while a real deployment failed. H2 is on the test classpath via protean, so this stays offline.
        r.add("amoeba.auth.authorization-store", () -> "jdbc");
        r.add("spring.datasource.url",
                () -> "jdbc:h2:mem:authrefresh-" + System.nanoTime() + ";DB_CLOSE_DELAY=-1");
        r.add("spring.datasource.driver-class-name", () -> "org.h2.Driver");
        r.add("spring.datasource.username", () -> "sa");
        r.add("spring.datasource.password", () -> "");
        // The SAME script an operator applies to the real database, so drift between the shipped DDL and what
        // JdbcOAuth2AuthorizationService needs breaks this test rather than the first production login.
        r.add("spring.sql.init.mode", () -> "always");
        r.add("spring.sql.init.schema-locations", () -> "classpath:db/oauth2-authorization-schema.sql");
    }

    @AfterAll
    static void cleanup() throws Exception {
        Files.deleteIfExists(keyFile);
    }

    private final HttpClient http = HttpClient.newBuilder()
            .followRedirects(HttpClient.Redirect.NEVER)
            .build();
    private final Map<String, String> cookies = new LinkedHashMap<>();

    @BeforeEach
    void freshSession() {
        cookies.clear();
    }

    @Test
    void loginIssuesARefreshTokenDespiteThisBeingAPublicClient() throws Exception {
        String body = logInAndGetTokenResponse("admin", "admin-pw", "mcp.read mcp.write");

        assertNotNull(jsonString(body, "refresh_token"),
                "★ Spring's OAuth2RefreshTokenGenerator returns null for authorization_code + NONE, so this is "
                        + "absent unless EmbeddedAuthServerConfig#tokenGenerator is wired: " + brief(body));
    }

    @Test
    void refreshMintsAWorkingTokenAndRotatesTheOldOneAway() throws Exception {
        String refresh = jsonString(logInAndGetTokenResponse("admin", "admin-pw", "mcp.read mcp.write"),
                "refresh_token");
        assertNotNull(refresh, "no refresh token to redeem");

        HttpResponse<String> refreshed = redeem(refresh);
        assertEquals(200, refreshed.statusCode(),
                "★ invalid_client here means the client-authentication converter is missing: " + refreshed.body());

        // Issuing and validating are separate halves — a test that stopped at the token endpoint would pass even
        // if every refreshed token was rejected by the Resource Server.
        String renewed = jsonString(refreshed.body(), "access_token");
        assertNotNull(renewed, "no access_token in the refresh response: " + brief(refreshed.body()));
        assertEquals(200, mcp(renewed, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}").statusCode(),
                "a refreshed token must reach /platform/mcp");

        // Rotation is what makes a refresh token acceptable for a public client at all.
        String rotated = jsonString(refreshed.body(), "refresh_token");
        assertNotNull(rotated, "rotation must hand back a new refresh token: " + brief(refreshed.body()));
        assertNotEquals(refresh, rotated, "★ the token must change on every use, or it is a static bearer");

        assertEquals(400, redeem(refresh).statusCode(),
                "★ replaying a rotated refresh token must be refused, or rotation buys nothing");
    }

    @Test
    void refreshedTokensKeepTheAudienceLockAndScopeNarrowing() throws Exception {
        // `reader` holds mcp.read only and asks for read+write. If the custom tokenGenerator ever stops
        // re-attaching tokenCustomizer, the two tests above still pass while THIS one fails — which is the whole
        // reason it exists.
        String refresh = jsonString(logInAndGetTokenResponse("reader", "reader-pw", "mcp.read mcp.write"),
                "refresh_token");
        assertNotNull(refresh, "no refresh token to redeem");

        HttpResponse<String> refreshed = redeem(refresh);
        assertEquals(200, refreshed.statusCode(), "refresh grant failed: " + refreshed.body());

        Map<String, Object> claims = claimsOf(jsonString(refreshed.body(), "access_token"));
        assertEquals(BASE, claims.get("iss"), "iss must survive the refresh");
        assertTrue(String.valueOf(claims.get("aud")).contains(RESOURCE_ID),
                "★ audience lock must survive the refresh: " + claims.get("aud"));
        String scope = String.valueOf(claims.get("scope"));
        assertTrue(scope.contains("mcp.read"), "read is held: " + scope);
        assertFalse(scope.contains("mcp.write"),
                "★ per-user narrowing must survive the refresh — reader must not gain write: " + scope);
    }

    // ── flow ──────────────────────────────────────────────────────────────────────────────────────────────────

    private HttpResponse<String> redeem(String refreshToken) throws Exception {
        return postForm(BASE + "/oauth2/token", Map.of(
                "grant_type", "refresh_token",
                "refresh_token", refreshToken,
                "client_id", CLIENT_ID));
    }

    /** authorize → login → back to authorize → code → PKCE exchange. Returns the whole token response. */
    private String logInAndGetTokenResponse(String username, String password, String scope) throws Exception {
        String verifier = verifier();

        Map<String, String> params = new LinkedHashMap<>();
        params.put("response_type", "code");
        params.put("client_id", CLIENT_ID);
        params.put("redirect_uri", REDIRECT_URI);
        params.put("scope", scope);
        params.put("code_challenge", challengeOf(verifier));
        params.put("code_challenge_method", "S256");
        assertEquals(302, get(BASE + "/oauth2/authorize?" + form(params)).statusCode(),
                "unauthenticated authorize must redirect to the login form");

        assertEquals(200, get(BASE + "/login").statusCode(), "/login must render");
        HttpResponse<String> submit = postForm(BASE + "/login",
                Map.of("username", username, "password", password));
        assertEquals(302, submit.statusCode(), "form login always ends in a redirect: " + brief(submit.body()));
        String back = location(submit);
        assertTrue(back.contains("/oauth2/authorize"), "login must return to the SavedRequest. Got: " + back);

        HttpResponse<String> authorized = get(back);
        assertEquals(302, authorized.statusCode(), "authenticated authorize should redirect to the callback");
        String code = queryParam(location(authorized), "code");
        assertNotNull(code, "no authorization code in " + location(authorized));

        HttpResponse<String> token = postForm(BASE + "/oauth2/token", Map.of(
                "grant_type", "authorization_code",
                "code", code,
                "redirect_uri", REDIRECT_URI,
                "client_id", CLIENT_ID,
                "code_verifier", verifier));
        assertEquals(200, token.statusCode(), "token exchange failed: " + token.body());
        return token.body();
    }

    private HttpResponse<String> mcp(String bearer, String body) throws Exception {
        HttpRequest.Builder b = HttpRequest.newBuilder(URI.create(RESOURCE_ID))
                .header("Content-Type", "application/json")
                .header("Accept", "application/json")
                .POST(HttpRequest.BodyPublishers.ofString(body));
        if (bearer != null) {
            b.header("Authorization", "Bearer " + bearer);
        }
        return http.send(b.build(), HttpResponse.BodyHandlers.ofString());
    }

    // ── HTTP plumbing (same shape as EmbeddedAuthFlowTest) ─────────────────────────────────────────────────────

    private HttpResponse<String> get(String url) throws Exception {
        HttpRequest.Builder b = HttpRequest.newBuilder(URI.create(url)).GET();
        applyCookies(b);
        HttpResponse<String> res = http.send(b.build(), HttpResponse.BodyHandlers.ofString());
        captureCookies(res);
        return res;
    }

    private HttpResponse<String> postForm(String url, Map<String, String> fields) throws Exception {
        HttpRequest.Builder b = HttpRequest.newBuilder(URI.create(url))
                .header("Content-Type", "application/x-www-form-urlencoded")
                .POST(HttpRequest.BodyPublishers.ofString(form(fields)));
        applyCookies(b);
        HttpResponse<String> res = http.send(b.build(), HttpResponse.BodyHandlers.ofString());
        captureCookies(res);
        return res;
    }

    private void applyCookies(HttpRequest.Builder b) {
        if (!cookies.isEmpty()) {
            StringBuilder sb = new StringBuilder();
            cookies.forEach((k, v) -> sb.append(sb.isEmpty() ? "" : "; ").append(k).append('=').append(v));
            b.header("Cookie", sb.toString());
        }
    }

    /** Session fixation protection rotates the id at login — refresh on every response or the flow breaks. */
    private void captureCookies(HttpResponse<String> res) {
        for (String set : res.headers().allValues("set-cookie")) {
            String pair = set.split(";", 2)[0];
            int eq = pair.indexOf('=');
            if (eq > 0) {
                cookies.put(pair.substring(0, eq).trim(), pair.substring(eq + 1).trim());
            }
        }
    }

    private static String location(HttpResponse<String> res) {
        return res.headers().firstValue("location").orElseThrow(
                () -> new AssertionError("expected a Location header, got status " + res.statusCode()));
    }

    private static String form(Map<String, String> fields) {
        StringBuilder sb = new StringBuilder();
        fields.forEach((k, v) -> {
            if (!sb.isEmpty()) {
                sb.append('&');
            }
            sb.append(URLEncoder.encode(k, StandardCharsets.UTF_8))
                    .append('=')
                    .append(URLEncoder.encode(v, StandardCharsets.UTF_8));
        });
        return sb.toString();
    }

    private static String queryParam(String url, String name) {
        int q = url.indexOf('?');
        if (q < 0) {
            return null;
        }
        for (String pair : url.substring(q + 1).split("&")) {
            String[] kv = pair.split("=", 2);
            if (kv.length == 2 && kv[0].equals(name)) {
                return java.net.URLDecoder.decode(kv[1], StandardCharsets.UTF_8);
            }
        }
        return null;
    }

    private static String verifier() {
        byte[] b = new byte[32];
        new java.security.SecureRandom().nextBytes(b);
        return Base64.getUrlEncoder().withoutPadding().encodeToString(b);
    }

    private static String challengeOf(String verifier) throws Exception {
        byte[] digest = MessageDigest.getInstance("SHA-256").digest(verifier.getBytes(StandardCharsets.US_ASCII));
        return Base64.getUrlEncoder().withoutPadding().encodeToString(digest);
    }

    /** Minimal JSON string extraction — enough for flat token responses, and keeps this test dependency-free. */
    private static String jsonString(String json, String field) {
        String needle = "\"" + field + "\"";
        int i = json.indexOf(needle);
        if (i < 0) {
            return null;
        }
        int colon = json.indexOf(':', i + needle.length());
        int start = json.indexOf('"', colon + 1);
        int end = json.indexOf('"', start + 1);
        return (start < 0 || end < 0) ? null : json.substring(start + 1, end);
    }

    /** Decodes the JWT payload without verifying — the server already verified it by accepting the token. */
    @SuppressWarnings("unchecked")
    private static Map<String, Object> claimsOf(String jwt) throws Exception {
        String payload = new String(
                Base64.getUrlDecoder().decode(jwt.split("\\.")[1]), StandardCharsets.UTF_8);
        return new com.fasterxml.jackson.databind.ObjectMapper().readValue(payload, Map.class);
    }

    private static String brief(String s) {
        return s == null ? "null" : (s.length() > 400 ? s.substring(0, 400) + "…" : s);
    }
}
