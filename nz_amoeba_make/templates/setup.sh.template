#!/usr/bin/env bash
#
# Install + run the {{NAME}} Protean sample on a Linux/Ubuntu server.
# Generated by nz_amoeba_make for the selected configuration.
#
#   ./setup.sh           preflight checks, then start the DB (if any) and run the server
#   ./setup.sh --check           run preflight checks only, then exit (nothing started)
#   SERVER_PORT=9090 ./setup.sh  override the HTTP port (default {{PORT}})
#   SERVER_HOST=mcp.example.com ...  externally visible host advertised via MCP discovery (default localhost)
#
# SERVER_PORT is deliberately that exact name: it is the env var Spring Boot already relaxed-binds to server.port,
# and application.yml derives `server.port: ${SERVER_PORT:{{PORT}}}` from it. So the caller's value reaches the app
# through the EXPORTED ENVIRONMENT — `./gradlew run` needs no extra argument — and the port this script checks is
# the port the app actually binds. Any other name (PORT, MCP_PORT, …) would be a knob that changes nothing.
#
set -euo pipefail

# This sample runs via `./gradlew run` (EXPLODED classpath). Do NOT `java -jar` the bootJar: the runtime module
# compiler builds its classpath from java.class.path and cannot see a fat jar's nested BOOT-INF/lib, so module
# compilation (and the deploy gate test) would fail. Only the container isolation track needs a bootJar (it
# explodes it for the module container), and this script builds it below.

# ---- selection (filled at generation) ----
COORD="{{COORD}}"
VERSION="{{VERSION}}"
IS_SNAPSHOT="{{IS_SNAPSHOT}}"       # true | false — SNAPSHOT resolves from mavenLocal
HAS_DB_DOCKER="{{HAS_DB_DOCKER}}"   # true | false — sample manages a DB via docker compose
HAS_DB_EXTERNAL="{{HAS_DB_EXTERNAL}}" # true | false — data access against an ALREADY-RUNNING server (existing/other)
DB_NAME="{{DB}}"                    # the schema hardcoded in application.yml's JDBC URL (empty when no data access)
ISOLATION="{{ISOLATION}}"          # in-process | worker | container
WORKER_RUNTIME="{{WORKER_RUNTIME}}"          # embed | sidecar — protean.worker.runtime (embed for in-process)
SIDECAR_JAR="{{SIDECAR_JAR}}"                # protean.worker.sidecar.jar   (empty when unset)
SIDECAR_IMAGE="{{SIDECAR_IMAGE}}"            # protean.worker.sidecar.image (empty when unset)
SIDECAR_SHARED_API="{{SIDECAR_SHARED_API}}"  # protean.worker.sidecar.shared-api (empty when unset)
OAUTH="{{OAUTH}}"                    # true | false — protean.mcp.authorization.resource is set
SERVER_HOST="${SERVER_HOST:-localhost}"  # ADVERTISED hostname (not a bind address — that would be server.address)
SERVER_PORT="${SERVER_PORT:-{{PORT}}}"   # see the header: this name is what carries through to server.port
export SERVER_HOST SERVER_PORT       # the app reads both from the environment; no command-line argument needed
RESOURCE_URL="http://${SERVER_HOST}:${SERVER_PORT}/platform/mcp"

CHECK_ONLY="false"
[ "${1:-}" = "--check" ] && CHECK_ONLY="true"

cd "$(dirname "$0")"
log()  { printf '\n\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

log "Preflight checks (Ubuntu/Linux)"

# JDK 21+ — modules are compiled at runtime with javac, so a JDK (not a JRE) is required.
if have javac; then
  # Parse the major version without grep (robust to GREP_OPTIONS/-n/--color): "javac 21.0.11" -> 21
  jv="$(javac -version 2>&1 | awk '{print $2}' | cut -d. -f1)"
  case "${jv}" in ''|*[!0-9]*) jv=0 ;; esac
  [ "${jv}" -ge 21 ] || err "JDK 21+ required (found: $(javac -version 2>&1)). Install: sudo apt-get install -y openjdk-21-jdk"
  echo "  JDK: javac ${jv} OK"
elif have java; then
  err "A JRE (java) is present but javac is missing. Protean compiles modules at runtime → install a JDK: sudo apt-get install -y openjdk-21-jdk"
else
  warn "No java/javac on PATH. The Gradle toolchain will try to provision JDK 21 (needs network). Recommended: sudo apt-get install -y openjdk-21-jdk"
fi

# Gradle wrapper
[ -x ./gradlew ] || err "./gradlew is missing or not executable. Provision it: gradle wrapper --gradle-version 8.14.5"
echo "  Gradle wrapper: OK"

# Protean jar (SNAPSHOT resolves from the local Maven cache)
if [ "${IS_SNAPSHOT}" = "true" ]; then
  gpath="$(printf '%s' "${COORD%%:*}" | tr '.' '/')"
  art="${COORD##*:}"
  pom="${HOME}/.m2/repository/${gpath}/${art}/${VERSION}/${art}-${VERSION}.pom"
  [ -f "${pom}" ] || err "Protean ${VERSION} is not in mavenLocal. Publish it first from the protean repo: ./gradlew publishToMavenLocal"
  echo "  Protean ${VERSION}: found in mavenLocal"
fi

# Docker — needed when the sample manages a DB via docker compose, AND for the container isolation track.
if [ "${HAS_DB_DOCKER}" = "true" ] || [ "${ISOLATION}" = "container" ]; then
  have docker || err "Docker is not installed. See https://docs.docker.com/engine/install/ubuntu/"
  docker info >/dev/null 2>&1 || err "Docker daemon not running or no permission (sudo systemctl start docker; sudo usermod -aG docker \"\$USER\")."
  if [ "${HAS_DB_DOCKER}" = "true" ]; then
    docker compose version >/dev/null 2>&1 || err "The 'docker compose' plugin is not available."
  fi
  echo "  Docker: OK"
fi

# ---- EXTERNAL DATABASE ---------------------------------------------------------------------------------------
# Data access against a server this sample does NOT manage (db-vendors.yaml `existing` / `other`): no compose, no
# init SQL, and the schema is applied by a human.
#
# ★ WHY THIS BLOCK EXISTS AT ALL. Unlike OAUTH_ISSUER_URI, a missing DB_PASSWORD does NOT stop the app. It is
# bound by the @ConfigurationProperties Binder, which leaves an unresolved ${...} in place as a literal string
# (ignoreUnresolvablePlaceholders=true), and Hikari connects lazily — nothing probes the database at startup. So
# the app comes up with a banner and a green log, and the first module to touch the DB fails. This check and
# docker-compose.yml's `:?` guard are the only early warnings that exist; docker-compose.app.yml.template's
# comment names this check, so do not delete one without the other.
if [ "${HAS_DB_EXTERNAL}" = "true" ]; then
  db_host="${DB_HOST:-localhost}"
  db_port="${DB_PORT:-3306}"

  if [ -z "${DB_PASSWORD:-}" ]; then
    err "DB_PASSWORD is not set, and application.yml has no fallback for it on an existing-server deployment (the
  real credential lives in no committed file).
  ⚠ This one does NOT stop the app on its own: it starts normally and fails at the FIRST query instead. Set it:
    export DB_PASSWORD=<password>"
  fi
  echo "  DB target:  ${DB_USER:-<application.yml default>}@${db_host}:${db_port}/${DB_NAME}"

  # The application.yml fallback for DB_HOST is `localhost` because it has to be safe to publish, not because it
  # is right. Say so while it is still in effect rather than letting a connection-refused explain it later.
  if [ -z "${DB_HOST:-}" ]; then
    warn "DB_HOST is unset, so the application.yml fallback 'localhost' applies. That is correct only if the
  database runs on this machine. Inside a container it means the container itself."
  fi

  # Reachability probe. A WARNING, not an error: a VPN or firewall rule may legitimately come up after this
  # script, and refusing to start the server for that would be wrong. bash's /dev/tcp needs no extra tooling.
  if have timeout && timeout 5 bash -c "cat < /dev/null > /dev/tcp/${db_host}/${db_port}" 2>/dev/null; then
    echo "  DB reachable: ${db_host}:${db_port} OK"
  else
    warn "cannot confirm a TCP connection to ${db_host}:${db_port} (or 'timeout' is unavailable). The app will
  still start — Hikari connects lazily — and the failure will surface at the first query."
  fi

  # ★ NO TOOL RUNS DDL. Say it here, because the deploy-time failure is far from this point.
  echo "  Reminder: apply the schema to '${DB_NAME}' before the first module deploy (no tool runs DDL)."
fi

# Sidecar worker runtime — an EXTERNAL worker artifact replaces the embed runtime's bootJar explode. Protean
# resolves it at the first worker spawn (first deploy), not at startup, and throws IllegalStateException when the
# key for this track is blank: the process track needs worker.sidecar.jar, the container track needs
# worker.sidecar.image (SidecarWorkerRuntime). Fail here instead — before anything is deployed.
if [ "${WORKER_RUNTIME}" = "sidecar" ]; then
  if [ "${ISOLATION}" = "container" ]; then
    [ -n "${SIDECAR_IMAGE}" ] || err "worker.runtime=sidecar + isolation.mode=container requires protean.worker.sidecar.image (GHCR protean-worker) in application.yml"
    if docker image inspect "${SIDECAR_IMAGE}" >/dev/null 2>&1; then
      echo "  sidecar image: ${SIDECAR_IMAGE} present"
    else
      warn "sidecar image ${SIDECAR_IMAGE} is not present locally — pull it before the first deploy: docker pull ${SIDECAR_IMAGE}"
    fi
  else
    [ -n "${SIDECAR_JAR}" ] || err "worker.runtime=sidecar + isolation.mode=${ISOLATION} requires protean.worker.sidecar.jar in application.yml"
    [ -f "${SIDECAR_JAR}" ] || err "sidecar jar not found: ${SIDECAR_JAR} — use the flat '-worker' uber-jar (shadow plugin or the published -worker classifier artifact); a Boot fat jar will not work."
    echo "  sidecar jar: ${SIDECAR_JAR} OK"
    if [ -n "${SIDECAR_SHARED_API}" ]; then
      [ -f "${SIDECAR_SHARED_API}" ] || err "sidecar shared-api jar not found: ${SIDECAR_SHARED_API}"
      echo "  sidecar shared-api: ${SIDECAR_SHARED_API} OK"
    fi
  fi
fi

# Container isolation track (embed runtime) — modules run in one hardened Docker container each; the runtime
# explodes the host bootJar (a literal build/libs/*-boot.jar). Build it up front so 'gradle bootJar' has run before
# the first deploy. Under runtime=sidecar the image bundles app + shared-api, so no bootJar is needed.
if [ "${ISOLATION}" = "container" ] && [ "${WORKER_RUNTIME}" != "sidecar" ]; then
  log "Building the worker bootJar for container isolation (./gradlew bootJar)"
  ./gradlew bootJar --console=plain
  ls build/libs/*-boot.jar >/dev/null 2>&1 || err "no build/libs/*-boot.jar after bootJar (check the bootJar archiveClassifier='boot' in build.gradle)"
  echo "  bootJar (-boot.jar): OK"
fi

# [OPTIONAL secured MCP] OAuth2 issuer — REQUIRED with no fallback. The app already refuses to start without a
# usable one (SecurityConfig's constructor), so this is the readable first line of defence: a clear message instead
# of a stack trace, and --check catches it without booting at all.
if [ "${OAUTH}" = "true" ]; then
  if [ -z "${OAUTH_ISSUER_URI:-}" ]; then
    err "OAUTH_ISSUER_URI is not set. The MCP control plane (/platform/**) requires a JWT issuer, and there is no
  default on purpose — /platform/mcp is an RCE surface. Set it and re-run:
    export OAUTH_ISSUER_URI=https://<your-as-host>/realms/<realm>
  Use the AS's issuer identifier — the exact 'iss' claim string its tokens carry, not the token endpoint or JWKS
  URL. Confirm it with:
    curl -s <candidate>/.well-known/openid-configuration | jq -r .issuer
  Your AS must also issue the scopes this sample advertises (see README section 'Security')."
  fi
  echo "  OAUTH_ISSUER_URI: ${OAUTH_ISSUER_URI}"
  # Echo the identifier that actually goes out over discovery, so a wrong host/port is caught here rather than by a
  # client that silently cannot reach it.
  echo "  MCP resource:     ${RESOURCE_URL}"
fi

# HTTP port free — this is the real bind port (server.port derives from SERVER_PORT), so the check is meaningful.
#
# ★ A CHECK THAT CANNOT RUN MUST SAY SO. This used to read `if have ss && ss -ltn | grep -q ...` followed by an
# unconditional `echo "Port free"`, which meant that on any host without iproute2 the check silently evaporated
# while still printing "free" — a missing check that looked like a passing one. (Observed on Windows/Git Bash,
# where `ss` does not exist.) Try the three usual tools, and when none is present print `skipped` rather than a
# reassurance nobody earned.
port_listeners() {
  if   have ss;      then ss -ltn 2>/dev/null
  elif have lsof;    then lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null
  elif have netstat; then netstat -ltn 2>/dev/null
  else return 127
  fi
}
# Run it ONCE and keep the output: calling the function twice (once to test, once to grep) lets the guard and the
# check disagree. An empty result counts as "could not check" rather than "nothing is listening" — every one of
# these tools prints a header on success, and biasing the unknown case towards a warning is the safe direction.
# (A present-but-unusable tool lands here too: Windows' netstat.exe rejects `-ltn`, so Git Bash takes this path.)
listeners="$(port_listeners)" || listeners=""
if [ -n "${listeners}" ]; then
  if printf '%s\n' "${listeners}" | grep -q "[:.]${SERVER_PORT}[[:space:]]"; then
    err "Port ${SERVER_PORT} is already in use. Re-run with a different port: SERVER_PORT=<n> ./setup.sh"
  fi
  echo "  Port ${SERVER_PORT}: free"
else
  warn "port check SKIPPED — no usable listener tool (ss/lsof/netstat) on this host, so nothing verified that
  ${SERVER_PORT} is free. A clash will surface as a BindException when the server starts."
fi

log "Preflight OK"
if [ "${CHECK_ONLY}" = "true" ]; then
  log "--check complete (nothing was started)."
  exit 0
fi

if [ "${HAS_DB_DOCKER}" = "true" ]; then
  log "Starting the database (docker compose up -d --wait)"
  docker compose up -d --wait
fi

log "Starting the server on port ${SERVER_PORT} (./gradlew run) — Ctrl-C to stop"
# SERVER_PORT (and SERVER_HOST, when the MCP resource identifier is advertised) reach the app through the exported
# environment, not the command line.
exec ./gradlew run
