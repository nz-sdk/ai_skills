// [COMMON SUPPORT] Test of the support package — ALWAYS emitted, to src/test/java/{{PKG_PATH}}/support/, class name
// kept (the support classes are never renamed).
//
// Everything in support/ is a seam that does nothing yet, so nothing else exercises it — and every way it can break is
// silent: a filter that stops calling the chain, an interceptor that returns false, an @EnableWebMvc that switches off
// Boot's MVC autoconfiguration, an interceptor that does not reach the routes protean registers at runtime, an
// abstract method on BaseMapper that every module's mapper XML would then have to provide. Each is pinned here, so the
// first concern someone adds to these classes starts from a wiring known to work.
//
// No application context of the app is started: the filter and interceptor are driven directly, and the MVC wiring
// runs in a minimal context holding only Boot's MVC autoconfiguration and these two classes.
package {{PKG}}.support;

import jakarta.servlet.FilterChain;
import jakarta.servlet.ServletException;

import org.junit.jupiter.api.Test;
import org.springframework.boot.autoconfigure.AutoConfigurations;
import org.springframework.boot.autoconfigure.http.HttpMessageConvertersAutoConfiguration;
import org.springframework.boot.autoconfigure.jackson.JacksonAutoConfiguration;
import org.springframework.boot.autoconfigure.security.SecurityProperties;
import org.springframework.boot.autoconfigure.web.servlet.WebMvcAutoConfiguration;
import org.springframework.boot.test.context.runner.WebApplicationContextRunner;
import org.springframework.core.Ordered;
import org.springframework.core.annotation.Order;
import org.springframework.mock.web.MockFilterChain;
import org.springframework.mock.web.MockHttpServletRequest;
import org.springframework.mock.web.MockHttpServletResponse;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.servlet.HandlerExecutionChain;
import org.springframework.web.servlet.config.annotation.EnableWebMvc;
import org.springframework.web.servlet.mvc.method.RequestMappingInfo;
import org.springframework.web.servlet.mvc.method.annotation.RequestMappingHandlerMapping;
import org.springframework.web.util.ServletRequestPathUtils;

import java.lang.reflect.Field;
import java.lang.reflect.Method;
import java.lang.reflect.Modifier;
import java.util.Arrays;
import java.util.List;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNotNull;
import static org.junit.jupiter.api.Assertions.assertNull;
import static org.junit.jupiter.api.Assertions.assertSame;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.junit.jupiter.api.Assertions.assertTrue;

class SupportWiringTest {

    @Test
    void theFilterPassesEveryRequestOnUnchanged() throws Exception {
        MockHttpServletRequest request = new MockHttpServletRequest("GET", "/orders/1");
        MockHttpServletResponse response = new MockHttpServletResponse();
        MockFilterChain chain = new MockFilterChain();

        new CommonFilter().doFilter(request, response, chain);

        assertSame(request, chain.getRequest(), "the chain must be called with the same request");
        assertSame(response, chain.getResponse());
        assertEquals(200, response.getStatus());
        assertTrue(response.getHeaderNames().isEmpty(), "headers added: " + response.getHeaderNames());
        assertEquals(0, response.getContentAsByteArray().length);
    }

    @Test
    void anExceptionFromTheChainIsNotSwallowed() {
        FilterChain failing = (request, response) -> {
            throw new ServletException("module failed");
        };
        assertThrows(ServletException.class, () -> new CommonFilter().doFilter(
                new MockHttpServletRequest("GET", "/orders/1"), new MockHttpServletResponse(), failing));
    }

    @Test
    void theFilterSitsAfterProteansTracingAndBeforeSpringSecurity() {
        Order order = CommonFilter.class.getAnnotation(Order.class);
        assertNotNull(order, "without @Order the filter's position is left to registration order");
        assertTrue(order.value() > Ordered.HIGHEST_PRECEDENCE + 10, "after RequestTraceFilter: " + order.value());
        assertTrue(order.value() < SecurityProperties.DEFAULT_FILTER_ORDER,
                "before the security chain, so it also sees the requests security rejects: " + order.value());
    }

    @Test
    void theInterceptorNeverEndsARequest() throws Exception {
        assertTrue(new CommonInterceptor().preHandle(
                new MockHttpServletRequest("GET", "/orders/1"), new MockHttpServletResponse(), new Object()),
                "preHandle returning false silently ends the request — every module would look broken");
    }

    @Test
    void theInterceptorReachesARouteRegisteredAtRuntime() {
        // protean's DynamicEndpointRegistrar registers module routes on the host's RequestMappingHandlerMapping after
        // startup. Register one the same way and check the interceptor is on its handler chain.
        new WebApplicationContextRunner()
                .withConfiguration(AutoConfigurations.of(WebMvcAutoConfiguration.class,
                        HttpMessageConvertersAutoConfiguration.class, JacksonAutoConfiguration.class))
                .withUserConfiguration(CommonInterceptor.class, WebSupportConfig.class)
                .run(context -> {
                    assertNull(context.getStartupFailure(), () -> "MVC wiring failed: " + context.getStartupFailure());
                    RequestMappingHandlerMapping mapping =
                            context.getBean("requestMappingHandlerMapping", RequestMappingHandlerMapping.class);
                    RequestMappingInfo route = RequestMappingInfo.paths("/orders/ping")
                            .methods(RequestMethod.GET)
                            .options(mapping.getBuilderConfiguration())
                            .build();
                    mapping.registerMapping(route, new ModuleRoute(), ModuleRoute.class.getMethod("ping"));

                    MockHttpServletRequest request = new MockHttpServletRequest("GET", "/orders/ping");
                    ServletRequestPathUtils.parseAndCache(request);
                    HandlerExecutionChain chain = mapping.getHandler(request);

                    assertNotNull(chain, "the runtime route is not mapped");
                    assertTrue(chain.getInterceptorList().contains(context.getBean(CommonInterceptor.class)),
                            "CommonInterceptor is not on a module route: " + chain.getInterceptorList());
                });
    }

    @Test
    void webSupportConfigAugmentsBootInsteadOfReplacingIt() {
        assertNull(WebSupportConfig.class.getAnnotation(EnableWebMvc.class),
                "@EnableWebMvc switches off WebMvcAutoConfiguration — converters, ObjectMapper, error handling");
    }

    @Test
    void baseMapperDemandsNoStatementFromAnyModule() {
        assertTrue(BaseMapper.class.isInterface(), "a MyBatis Mapper is an interface, so its base must be one");
        List<String> abstractMethods = Arrays.stream(BaseMapper.class.getDeclaredMethods())
                .filter(m -> Modifier.isAbstract(m.getModifiers()))
                .map(Method::getName)
                .toList();
        assertEquals(List.of(), abstractMethods,
                "every module's mapper XML would need a statement for each of these");
    }

    @Test
    void baseServiceIsAnAbstractSeamWithoutSharedMutableState() {
        assertTrue(Modifier.isAbstract(BaseService.class.getModifiers()), "a seam, never a bean on its own");
        List<String> mutableStatics = Arrays.stream(BaseService.class.getDeclaredFields())
                .filter(f -> !f.isSynthetic())
                .filter(f -> Modifier.isStatic(f.getModifiers()) && !Modifier.isFinal(f.getModifiers()))
                .map(Field::getName)
                .toList();
        assertEquals(List.of(), mutableStatics,
                "shared across module ClassLoaders: a mutable static leaks between modules and pins them");
    }

    /** Stands in for a deployed module's controller. */
    public static class ModuleRoute {
        public String ping() {
            return "pong";
        }
    }
}
