// [CAPABILITY: custom MCP tool] amoeba.explain_query — the optimizer's estimated plan for one query, on whichever
// vendor the DataSource is. The statement is never executed (no EXPLAIN ANALYZE): PlanReader asks the planner only,
// inside QueryEnvelope's guarded, rolled-back transaction. Requires mcp.write — see QueryToolSupport for why even a
// plan is not an mcp.read answer.
package {{PKG}}.db.query;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.node.ObjectNode;

import {{PKG}}.db.DbToolSchemas;
import {{PKG}}.db.query.QueryEnvelope.Mode;
import {{PKG}}.db.query.QueryEnvelope.Refused;

import org.htcom.protean.mcp.McpCallContext;
import org.htcom.protean.mcp.McpTool;
import org.htcom.protean.mcp.McpToolAnnotations;
import org.htcom.protean.mcp.McpToolResult;
import org.htcom.protean.mcp.ModuleActionAuthorizer;

import org.springframework.stereotype.Component;

import java.nio.charset.StandardCharsets;
import java.sql.SQLException;

@Component
public class ExplainQueryTool implements McpTool {

    static final String NAME = "amoeba.explain_query";

    private final ObjectMapper mapper;
    private final QueryEnvelope envelope;

    public ExplainQueryTool(ObjectMapper mapper, QueryEnvelope envelope) {
        this.mapper = mapper;
        this.envelope = envelope;
    }

    @Override
    public String name() {
        return NAME;
    }

    @Override
    public String title() {
        return "Explain a Query Plan";
    }

    @Override
    public String description() {
        return "Returns the optimizer's ESTIMATED execution plan for one query without running it — EXPLAIN on "
                + "MySQL/MariaDB/PostgreSQL/H2, EXPLAIN PLAN + DBMS_XPLAN on Oracle, SHOWPLAN_XML on SQL Server; the "
                + "vendor is detected from the connection and reported in 'vendor'. 'plan' is the vendor's own "
                + "structured form (JSON, or the XML document on SQL Server) and 'text' a readable rendering. "
                + "'database'/'schema' work as in amoeba.list_tables. The statement is checked before it is sent "
                + "(see 'sql') and planned inside a transaction that is always rolled back. Use it to check index "
                + "use and join order before shipping a mapper query; amoeba.describe_table shows which indexes "
                + "exist. Requires mcp.write: even an estimated plan can reveal row contents.";
    }

    @Override
    public ModuleActionAuthorizer.ModuleAction action() {
        return QueryToolSupport.ACTION;
    }

    @Override
    public String targetModuleId(JsonNode arguments) {
        return null;
    }

    @Override
    public McpToolAnnotations annotations() {
        return McpToolAnnotations.readOnly();
    }

    @Override
    public ObjectNode inputSchema() {
        ObjectNode schema = mapper.createObjectNode();
        schema.put("type", "object");
        schema.put("additionalProperties", false);
        ObjectNode p = schema.putObject("properties");
        QueryToolSupport.putSqlArgs(p, "The query to plan. It is never executed.");
        schema.putArray("required").add("sql");
        return schema;
    }

    @Override
    public ObjectNode outputSchema() {
        ObjectNode schema = mapper.createObjectNode();
        schema.put("type", "object");
        ObjectNode p = schema.putObject("properties");
        QueryToolSupport.putVendor(p);
        DbToolSchemas.putLocation(p);
        ObjectNode format = p.putObject("format");
        format.put("type", "string").put("description", "What 'plan' holds: json, xml (SQL Server), text (H2).");
        format.putArray("enum").add("json").add("xml").add("text");
        p.putObject("plan").put("description", "The plan as the vendor reports it: a JSON value for json, the "
                + "document as a string for xml and text. Omitted from the result (planTruncated) when larger than "
                + "amoeba.db-query.max-bytes.");
        p.putObject("text").put("type", "string").put("description", "A readable rendering of the plan.");
        p.putObject("planTruncated").put("type", "boolean");
        schema.putArray("required").add("vendor").add("format").add("text");
        return schema;
    }

    @Override
    public McpToolResult call(JsonNode arguments, McpCallContext ctx) {
        JsonNode args = arguments == null ? mapper.missingNode() : arguments;
        String sql = QueryToolSupport.sql(args);
        String database = QueryToolSupport.text(args, "database");
        String schema = QueryToolSupport.text(args, "schema");
        long started = System.nanoTime();
        try {
            return envelope.run(sql, database, schema, Mode.PLAN, session -> {
                PlanReader.Plan plan = PlanReader.explain(session, mapper);
                ObjectNode out = mapper.createObjectNode();
                out.put("vendor", QueryToolSupport.wire(session.vendor()));
                QueryToolSupport.putLocation(out, session.location());
                out.put("format", plan.format());
                int maxBytes = envelope.settings().maxBytes();
                String text = plan.text();
                boolean cut = false;
                if (plan.plan().toString().getBytes(StandardCharsets.UTF_8).length <= maxBytes) {
                    out.set("plan", plan.plan());
                } else {
                    cut = true;
                }
                if (text.length() > maxBytes) {
                    text = text.substring(0, maxBytes) + "…";
                    cut = true;
                }
                out.put("text", text);
                if (cut) {
                    out.put("planTruncated", true);
                }
                String where = QueryToolSupport.where(session.vendor(), session.location());
                QueryToolSupport.audit(NAME, ctx, where, sql, "ok", -1, QueryToolSupport.elapsed(started));
                return McpToolResult.ok("Estimated plan (" + where + ", " + plan.format() + "):\n" + text, out);
            });
        } catch (Refused e) {
            return QueryToolSupport.refused(NAME, ctx, sql, e.getMessage());
        } catch (SQLException e) {
            return QueryToolSupport.failed(NAME, ctx, sql, e, started);
        }
    }
}
