// [CAPABILITY: custom MCP tool] Requires protean.mcp.enabled=true.
// A @Component implementing McpTool is auto-collected by McpDispatcher and listed in tools/list alongside the
// built-in protean.* tools — no server change. This example echoes and uppercases its input: it has NO
// dependencies, so it compiles whatever else was selected. Adapt name/schema/call to your own tool.
// See reference/protean-capabilities.md (Axis B).
//
// ★ CHECK action() BEFORE YOU SHIP A READ-ONLY TOOL. It returns CUSTOM below because that is the SPI default and
// the honest choice for a tool whose effects are unknown — but CUSTOM is what the `authorizer` capability's
// policy puts behind mcp.admin, the same bucket as config.set and deploy_shared_lib. So a tool that only READS
// left at this default silently demands admin rights to do it.
//   read-only  → override action() to return ModuleActionAuthorizer.ModuleAction.READ, and annotations() to
//                return McpToolAnnotations.readOnly(). The three amoeba.*_module_source tools in the
//                module_source_tools bundle do exactly this, and two of their tests pin it.
//   mutating   → leave CUSTOM.
// GENERATOR: when data_access is selected and the tool being generated reads the database, emit the READ
// override rather than this default.
package {{PKG}};

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.node.ObjectNode;

import org.htcom.protean.mcp.McpCallContext;
import org.htcom.protean.mcp.McpTool;
import org.htcom.protean.mcp.McpToolResult;
import org.htcom.protean.mcp.ModuleActionAuthorizer;

import org.springframework.stereotype.Component;

@Component
public class ExampleTool implements McpTool {

    private final ObjectMapper mapper;

    public ExampleTool(ObjectMapper mapper) {
        this.mapper = mapper;
    }

    @Override
    public String name() {
        return "{{NAME}}.example";
    }

    @Override
    public String description() {
        return "Example custom MCP tool for the {{NAME}} sample: echoes and uppercases its input.";
    }

    @Override
    public ObjectNode inputSchema() {
        ObjectNode schema = mapper.createObjectNode();
        schema.put("type", "object");
        ObjectNode p = schema.putObject("properties");
        p.putObject("text").put("type", "string").put("description", "Text to echo");
        schema.putArray("required").add("text");
        return schema;
    }

    @Override
    public ObjectNode outputSchema() {
        ObjectNode schema = mapper.createObjectNode();
        schema.put("type", "object");
        ObjectNode p = schema.putObject("properties");
        p.putObject("echoed").put("type", "string");
        schema.putArray("required").add("echoed");
        return schema;
    }

    @Override
    public String title() {
        return "Example Echo Tool";
    }

    /** CUSTOM = the SPI default → mcp.admin under the `authorizer` policy. Read-only tools: return READ instead. */
    @Override
    public ModuleActionAuthorizer.ModuleAction action() {
        return ModuleActionAuthorizer.ModuleAction.CUSTOM;
    }

    @Override
    public McpToolResult call(JsonNode arguments, McpCallContext ctx) {
        JsonNode args = arguments == null ? mapper.missingNode() : arguments;
        String text = args.hasNonNull("text") ? args.get("text").asText() : "";
        if (text.isEmpty()) {
            return McpToolResult.error("text is required");
        }
        String echoed = text.toUpperCase();
        ObjectNode out = mapper.createObjectNode();
        out.put("echoed", echoed);
        return McpToolResult.ok("echoed: " + echoed, out);
    }
}
