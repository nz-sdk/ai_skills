// [DB METADATA] Reads the host database's structure through JDBC DatabaseMetaData — never through caller SQL.
//
// This is what the two tools share, and where every vendor quirk is absorbed so the tools stay thin:
//
//   · SCOPE DEFAULTS TO THE CURRENT DATABASE. Catalog and schema come from the connection (getCatalog/getSchema)
//     unless the caller names another one; `database`/`schema` are then resolved against getCatalogs()/getSchemas(),
//     i.e. against what the DB ACCOUNT can see. That account's grants are the real boundary — what SHOW DATABASES
//     would not show, these tools cannot open either. System namespaces (SYSTEM_NAMESPACES) are refused outright
//     even when visible: their structure is the server's, not an application's.
//   · NAMES ARE RESOLVED IN JAVA. The full table list is read once and the requested name matched exactly, then
//     case-insensitively — H2 folds unquoted names to upper case, PostgreSQL to lower case, and MySQL on Linux keeps
//     them case-sensitive, so no single case rule works across vendors.
//   · '_' AND '%' ARE LIKE WILDCARDS in getTables/getColumns. A resolved name is escaped before it is used as a
//     pattern AND the rows are filtered back to that exact name; without it, describing comp_mst also returns the
//     columns of compxmst.
//   · TABLE_TYPE IS NORMALIZED. H2 2.x reports "BASE TABLE" where MySQL reports "TABLE", so the type filter is
//     applied after normalization instead of being passed to the driver.
//   · COMMENTS COME FROM THE DRIVER. Connector/J 9.x fills REMARKS for tables and columns on MySQL 8.4 with the
//     connection URL as it is — measured, and pinned by LiveMetadataTest. No information_schema fallback exists:
//     it would run on every call against any database with one uncommented table, for nothing. If a driver ever
//     stops reporting them, LiveMetadataTest is what fails; do not "fix" it by editing the shared URL, which
//     every deployed module uses.
//     The two exceptions are vendors whose driver NEVER reports them: ojdbc leaves REMARKS null unless the
//     connection sets remarksReporting (which slows every metadata call), and mssql-jdbc has no source for them —
//     SQL Server keeps comments as MS_Description extended properties. On those two only, comments are read from
//     ALL_TAB_COMMENTS/ALL_COL_COMMENTS and sys.extended_properties, best effort: a refused read leaves them null.
//   · THE VENDOR IS DETECTED, NOT CONFIGURED (DbVendor). It decides the system namespaces (SystemNamespaces), the
//     comment source above, and three location rules: Oracle has no database level (`database` is refused with a
//     pointer to `schema`), SQL Server opens another database at its dbo schema (otherwise every schema's tables
//     would be mixed into one list), and Oracle's recycle bin (BIN$…) is not a table anyone created.
package {{PKG}}.db;

import org.springframework.stereotype.Component;

import javax.sql.DataSource;
import java.sql.Connection;
import java.sql.DatabaseMetaData;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Types;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.HashMap;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.Optional;
import java.util.TreeMap;

@Component
public class DbMetadataReader {

    /** Close names offered back when a requested table does not exist. */
    static final int MAX_CANDIDATES = 10;

    /**
     * Sizes at or above this are a vendor's "unbounded" marker rather than a declared length — SQL Server reports
     * nvarchar(max) as 1073741823 (2^30−1) and varchar(max) as 2147483647 — and are shown as {@code (max)}.
     */
    static final int MAX_SIZE_MARKER = 1_073_741_823;

    private final DataSource dataSource;

    public DbMetadataReader(DataSource dataSource) {
        this.dataSource = dataSource;
    }

    // ---- model --------------------------------------------------------------------------------------------

    public enum TableType {
        TABLE("table"), VIEW("view");

        private final String wire;

        TableType(String wire) {
            this.wire = wire;
        }

        public String wire() {
            return wire;
        }

        public static Optional<TableType> fromWire(String value) {
            for (TableType type : values()) {
                if (type.wire.equalsIgnoreCase(value)) {
                    return Optional.of(type);
                }
            }
            return Optional.empty();
        }

        /** JDBC TABLE_TYPE → model. System tables, synonyms, temporaries and the like are not listed at all. */
        static Optional<TableType> fromJdbc(String value) {
            if (value == null) {
                return Optional.empty();
            }
            return switch (value.toUpperCase(Locale.ROOT)) {
                case "TABLE", "BASE TABLE" -> Optional.of(TABLE);
                case "VIEW" -> Optional.of(VIEW);
                default -> Optional.empty();
            };
        }
    }

    /** Where the connection points. Either part may be null depending on the vendor. */
    public record Location(String database, String schema) {
    }

    public record TableSummary(String name, TableType type, String comment) {
    }

    /**
     * The tables of one location, plus the other databases and schemas the account could open — so a caller picks
     * a name instead of guessing one. System namespaces are never in either list.
     */
    public record TableList(Location location, List<TableSummary> tables, List<String> databases,
                            List<String> schemas) implements Listing {
    }

    public record Column(String name, int position, String type, Integer size, Integer scale, boolean nullable,
                         String defaultValue, boolean autoIncrement, String comment) {
    }

    public record PrimaryKey(String name, List<String> columns) {
    }

    public record Index(String name, boolean unique, List<String> columns) {
    }

    /**
     * A foreign key seen from the described table. For {@code foreignKeys}, {@code columns} are this table's and
     * {@code otherTable}/{@code otherColumns} the referenced ones; for {@code referencedBy}, {@code otherTable} is
     * the referencing table, {@code columns} its columns, and {@code otherColumns} this table's.
     */
    public record ForeignKey(String name, List<String> columns, String otherTable, List<String> otherColumns,
                             String onUpdate, String onDelete) {
    }

    public record TableDetail(Location location, TableSummary table, List<Column> columns, PrimaryKey primaryKey,
                              List<Index> indexes, List<ForeignKey> foreignKeys, List<ForeignKey> referencedBy) {
    }

    /** Outcome of listing a location. */
    public sealed interface Listing permits TableList, UnknownLocation {
    }

    /** Outcome of resolving a caller-typed name against the tables that actually exist. */
    public sealed interface Lookup permits Found, NotFound, Ambiguous, UnknownLocation {
    }

    /** Outcome of resolving {@code database}/{@code schema} on a connection the caller owns. */
    public sealed interface Resolution permits Located, UnknownLocation {
    }

    /** A location that can be opened, with what was learned about the server while resolving it. */
    public record Located(Location location, DbVendor vendor, SystemNamespaces system) implements Resolution {
    }

    /**
     * A requested database or schema that cannot be opened: not visible to the account, or a system namespace.
     * {@code visible} is what could have been asked for instead.
     */
    public record UnknownLocation(String kind, String requested, boolean system, List<String> visible, String hint)
            implements Listing, Lookup, Resolution {

        public UnknownLocation(String kind, String requested, boolean system, List<String> visible) {
            this(kind, requested, system, visible, null);
        }

        public String message() {
            String head = system
                    ? kind + " '" + requested + "' is a system " + kind + " and is not visible through these tools"
                    : kind + " '" + requested + "' is not visible to this server's database account";
            String tail = visible.isEmpty() ? "." : ". Visible " + kind + "s: " + String.join(", ", visible) + ".";
            return head + tail + (hint == null ? "" : " " + hint);
        }
    }

    public record Found(TableDetail detail) implements Lookup {
    }

    public record NotFound(Location location, List<String> candidates) implements Lookup {
    }

    public record Ambiguous(List<String> names) implements Lookup {
    }

    // ---- reads --------------------------------------------------------------------------------------------

    /**
     * Every table and view of a location, sorted by name. {@code database}/{@code schema} are optional; null means
     * the connection's current one.
     */
    public Listing listTables(String database, String schema) throws SQLException {
        try (Connection conn = dataSource.getConnection()) {
            Ctx ctx = Ctx.of(conn);
            Resolved resolved = locate(ctx, database, schema);
            if (resolved.failure() != null) {
                return resolved.failure();
            }
            Location location = resolved.location();
            return new TableList(location, readTables(ctx, location), visible(ctx, catalogs(ctx)),
                    visible(ctx, schemas(ctx.meta(), location.database())));
        }
    }

    /**
     * One table's definition. The name may carry a qualifier: the chosen location's own database/schema is simply
     * stripped, and — only when neither {@code database} nor {@code schema} was given — another visible database
     * (then schema) moves the lookup there. A system qualifier is refused rather than reported as "no such table".
     */
    public Lookup describe(String requested, String database, String schema) throws SQLException {
        try (Connection conn = dataSource.getConnection()) {
            Ctx ctx = Ctx.of(conn);
            Resolved resolved = locate(ctx, database, schema);
            if (resolved.failure() != null) {
                return resolved.failure();
            }
            Location location = resolved.location();

            String wanted = unquote(requested.strip());
            int dot = wanted.indexOf('.');
            if (dot > 0) {
                String qualifier = unquote(wanted.substring(0, dot));
                String rest = unquote(wanted.substring(dot + 1));
                if (qualifier.equalsIgnoreCase(location.database()) || qualifier.equalsIgnoreCase(location.schema())) {
                    wanted = rest;
                } else if (ctx.system().contains(qualifier)) {
                    return new UnknownLocation("database", qualifier, true, visible(ctx, catalogs(ctx)));
                } else if (database == null && schema == null) {
                    Location moved = locateQualifier(ctx, qualifier);
                    if (moved != null) {
                        location = moved;
                        wanted = rest;
                    }
                }
            }
            String name = wanted;

            List<TableSummary> tables = readTables(ctx, location);

            List<TableSummary> exact = tables.stream().filter(t -> t.name().equals(name)).toList();
            List<TableSummary> matches = exact.isEmpty()
                    ? tables.stream().filter(t -> t.name().equalsIgnoreCase(name)).toList()
                    : exact;
            if (matches.size() > 1) {
                return new Ambiguous(matches.stream().map(TableSummary::name).toList());
            }
            if (matches.isEmpty()) {
                String lower = name.toLowerCase(Locale.ROOT);
                List<String> candidates = tables.stream()
                        .map(TableSummary::name)
                        .filter(n -> {
                            String candidate = n.toLowerCase(Locale.ROOT);
                            return candidate.contains(lower) || lower.contains(candidate);
                        })
                        .limit(MAX_CANDIDATES)
                        .toList();
                return new NotFound(location, candidates);
            }
            return new Found(readDetail(ctx, location, matches.get(0)));
        }
    }

    /**
     * Resolves the optional {@code database}/{@code schema} on a connection the CALLER owns, with exactly the rules
     * the two metadata tools apply (visible to the account, system namespaces refused, vendor location rules).
     *
     * <p>For the query tools: they resolve on the connection that will run the statement, so the boundary is the
     * account that connection belongs to — which may be a dedicated read-only account, not the host DataSource's.
     * Reads metadata only; the connection's state is not changed.
     */
    public static Resolution resolveLocation(Connection conn, String database, String schema) throws SQLException {
        Ctx ctx = Ctx.of(conn);
        Resolved resolved = locate(ctx, database, schema);
        return resolved.failure() != null ? resolved.failure()
                : new Located(resolved.location(), ctx.vendor(), ctx.system());
    }

    // ---- internals ----------------------------------------------------------------------------------------

    /** A resolved location, or why the requested one cannot be opened. Exactly one side is non-null. */
    private record Resolved(Location location, UnknownLocation failure) {
    }

    /** One connection with what every read on it needs: its metadata, its vendor, and that vendor's system names. */
    private record Ctx(Connection conn, DatabaseMetaData meta, DbVendor vendor, SystemNamespaces system) {

        static Ctx of(Connection conn) throws SQLException {
            DatabaseMetaData meta = conn.getMetaData();
            DbVendor vendor = DbVendor.detect(meta);
            return new Ctx(conn, meta, vendor, SystemNamespaces.of(conn, vendor));
        }
    }

    /** SQL Server's default schema in a database the connection is not currently in. */
    static final String SQLSERVER_DEFAULT_SCHEMA = "dbo";

    private static Location current(Connection conn) throws SQLException {
        String schema;
        try {
            schema = conn.getSchema();
        } catch (SQLException | AbstractMethodError e) {
            schema = null;   // pre-JDBC-4.1 drivers
        }
        return new Location(blankToNull(conn.getCatalog()), blankToNull(schema));
    }

    /**
     * Resolves the optional {@code database}/{@code schema} against what the account can see. A database other than
     * the current one drops the current schema (MySQL has no schema level; PostgreSQL cannot leave its database) —
     * except on SQL Server, where it opens at {@code dbo}, the schema every database has and the one an unqualified
     * name resolves to; with no schema at all getTables would mix every schema's tables into one list. The current
     * database named explicitly keeps the current schema.
     */
    private static Resolved locate(Ctx ctx, String database, String schema) throws SQLException {
        Location current = current(ctx.conn());
        String catalog = current.database();
        String sch = current.schema();
        if (database != null) {
            if (ctx.vendor() == DbVendor.ORACLE) {
                // Oracle has no level above the schema: getCatalogs() is empty, so every name would be "not visible"
                // and the caller would never learn why. Say where the other application's tables actually live.
                return new Resolved(null, new UnknownLocation("database", database, false, List.of(),
                        "Oracle has no database level — pass it as 'schema' (the owning user) instead."));
            }
            List<String> all = catalogs(ctx);
            if (ctx.system().contains(database)) {
                return new Resolved(null, new UnknownLocation("database", database, true, visible(ctx, all)));
            }
            String found = match(all, database);
            if (found == null) {
                return new Resolved(null, new UnknownLocation("database", database, false, visible(ctx, all),
                        ctx.vendor() == DbVendor.POSTGRESQL
                                ? "A PostgreSQL connection cannot open another database — only its schemas ('schema')."
                                : null));
            }
            if (!found.equals(catalog)) {
                sch = ctx.vendor() == DbVendor.SQLSERVER ? SQLSERVER_DEFAULT_SCHEMA : null;
            }
            catalog = found;
        }
        if (schema != null) {
            List<String> all = schemas(ctx.meta(), catalog);
            if (ctx.system().contains(schema)) {
                return new Resolved(null, new UnknownLocation("schema", schema, true, visible(ctx, all)));
            }
            String found = match(all, schema);
            if (found == null) {
                return new Resolved(null, new UnknownLocation("schema", schema, false, visible(ctx, all)));
            }
            sch = found;
        }
        return new Resolved(new Location(catalog, sch), null);
    }

    /** A table-name qualifier naming another visible database, else another visible schema; null when neither. */
    private static Location locateQualifier(Ctx ctx, String qualifier) throws SQLException {
        if (ctx.vendor() != DbVendor.ORACLE && match(visible(ctx, catalogs(ctx)), qualifier) != null) {
            return locate(ctx, qualifier, null).location();
        }
        Location current = current(ctx.conn());
        if (match(visible(ctx, schemas(ctx.meta(), current.database())), qualifier) != null) {
            return locate(ctx, null, qualifier).location();
        }
        return null;
    }

    /**
     * The databases a `database` argument may name. On PostgreSQL that is the current one only: pgjdbc's getCatalogs()
     * lists every database on the server, but a connection cannot leave its own — setCatalog is a no-op and
     * getTables on another catalog answers an empty list, so "database X has 0 tables" would be reported for a
     * database that was never read.
     */
    private static List<String> catalogs(Ctx ctx) throws SQLException {
        if (ctx.vendor() == DbVendor.POSTGRESQL) {
            String current = blankToNull(ctx.conn().getCatalog());
            return current == null ? List.of() : List.of(current);
        }
        List<String> names = new ArrayList<>();
        try (ResultSet rs = ctx.meta().getCatalogs()) {
            while (rs.next()) {
                names.add(rs.getString("TABLE_CAT"));
            }
        }
        return names;
    }

    /** Schemas of one catalog. MySQL (databaseTerm=CATALOG) reports none, which is correct: it has no such level. */
    private static List<String> schemas(DatabaseMetaData meta, String catalog) throws SQLException {
        List<String> names = new ArrayList<>();
        try (ResultSet rs = meta.getSchemas(catalog, null)) {
            while (rs.next()) {
                names.add(rs.getString("TABLE_SCHEM"));
            }
        }
        return names;
    }

    /** Sorted, without blanks and without system namespaces — the names worth offering to a caller. */
    private static List<String> visible(Ctx ctx, List<String> names) {
        return names.stream()
                .filter(n -> n != null && !n.isBlank() && !ctx.system().contains(n))
                .distinct()
                .sorted(Comparator.comparing((String n) -> n.toLowerCase(Locale.ROOT)).thenComparing(n -> n))
                .toList();
    }

    /** Exact name first; otherwise the single case-insensitive match. Two case-only twins match neither way. */
    private static String match(List<String> names, String requested) {
        for (String n : names) {
            if (n != null && n.equals(requested)) {
                return n;
            }
        }
        List<String> ci = names.stream().filter(n -> n != null && n.equalsIgnoreCase(requested)).toList();
        return ci.size() == 1 ? ci.get(0) : null;
    }

    private static String unquote(String s) {
        if (s.length() >= 2) {
            char first = s.charAt(0);
            char last = s.charAt(s.length() - 1);
            if ((first == '`' && last == '`') || (first == '"' && last == '"') || (first == '[' && last == ']')) {
                return s.substring(1, s.length() - 1);
            }
        }
        return s;
    }

    private List<TableSummary> readTables(Ctx ctx, Location location) throws SQLException {
        DatabaseMetaData meta = ctx.meta();
        String escape = meta.getSearchStringEscape();
        List<TableSummary> tables = new ArrayList<>();
        try (ResultSet rs = meta.getTables(location.database(), like(location.schema(), escape), null, null)) {
            while (rs.next()) {
                Optional<TableType> type = TableType.fromJdbc(rs.getString("TABLE_TYPE"));
                String name = rs.getString("TABLE_NAME");
                if (type.isEmpty() || (ctx.vendor() == DbVendor.ORACLE && name.startsWith("BIN$"))) {
                    continue;   // BIN$… is a dropped table waiting in Oracle's recycle bin
                }
                tables.add(new TableSummary(name, type.get(), comment(rs.getString("REMARKS"), type.get())));
            }
        }
        Map<String, String> comments = VendorComments.tables(ctx.conn(), ctx.vendor(), location);
        if (!comments.isEmpty()) {
            tables.replaceAll(t -> t.comment() != null || !comments.containsKey(t.name()) ? t
                    : new TableSummary(t.name(), t.type(), comments.get(t.name())));
        }
        tables.sort(Comparator.comparing((TableSummary t) -> t.name().toLowerCase(Locale.ROOT))
                .thenComparing(TableSummary::name));
        return tables;
    }

    private TableDetail readDetail(Ctx ctx, Location location, TableSummary table) throws SQLException {
        DatabaseMetaData meta = ctx.meta();
        String catalog = location.database();
        String schema = location.schema();
        String name = table.name();

        List<Column> columns = readColumns(meta, ctx.vendor(), catalog, schema, name);
        Map<String, String> columnComments = VendorComments.columns(ctx.conn(), ctx.vendor(), location, name);
        if (!columnComments.isEmpty()) {
            columns.replaceAll(c -> c.comment() != null || !columnComments.containsKey(c.name()) ? c
                    : new Column(c.name(), c.position(), c.type(), c.size(), c.scale(), c.nullable(),
                    c.defaultValue(), c.autoIncrement(), columnComments.get(c.name())));
        }
        PrimaryKey primaryKey = readPrimaryKey(meta, catalog, schema, name);
        List<Index> indexes = table.type() == TableType.TABLE
                ? readIndexes(meta, catalog, schema, name, primaryKey) : List.of();
        List<ForeignKey> foreignKeys = new ArrayList<>();
        List<ForeignKey> referencedBy = new ArrayList<>();
        if (table.type() == TableType.TABLE) {
            try (ResultSet rs = meta.getImportedKeys(catalog, schema, name)) {
                foreignKeys = readForeignKeys(rs, location, true);
            }
            try (ResultSet rs = meta.getExportedKeys(catalog, schema, name)) {
                referencedBy = readForeignKeys(rs, location, false);
            }
        }
        return new TableDetail(location, table, columns, primaryKey, indexes, foreignKeys, referencedBy);
    }

    private static List<Column> readColumns(DatabaseMetaData meta, DbVendor vendor, String catalog, String schema,
                                            String table) throws SQLException {
        String escape = meta.getSearchStringEscape();
        List<Column> columns = new ArrayList<>();
        try (ResultSet rs = meta.getColumns(catalog, like(schema, escape), like(table, escape), "%")) {
            while (rs.next()) {
                if (!table.equals(rs.getString("TABLE_NAME"))) {
                    continue;   // the LIKE match leaked a sibling table — see the header
                }
                int dataType = rs.getInt("DATA_TYPE");
                String typeName = typeName(rs.getString("TYPE_NAME"));
                Integer size = intOrNull(rs, "COLUMN_SIZE");
                Integer digits = intOrNull(rs, "DECIMAL_DIGITS");
                boolean sized = isSized(dataType, typeName);
                boolean scaled = dataType == Types.DECIMAL || dataType == Types.NUMERIC;
                // Oracle's bare NUMBER (no precision) arrives as size 0 / scale −127: it has neither, so show neither.
                Integer shownSize = (sized || scaled) && size != null && size > 0 ? size : null;
                Integer shownScale = scaled && shownSize != null && digits != null && digits >= 0 ? digits : null;
                String defaultValue = rs.getString("COLUMN_DEF");
                if (vendor == DbVendor.ORACLE && defaultValue != null) {
                    defaultValue = defaultValue.strip();   // ojdbc returns the DEFAULT clause as typed, newline and all
                }

                int nullable = rs.getInt("NULLABLE");
                boolean isNullable = nullable == DatabaseMetaData.columnNullableUnknown
                        ? "YES".equalsIgnoreCase(rs.getString("IS_NULLABLE"))
                        : nullable == DatabaseMetaData.columnNullable;

                columns.add(new Column(
                        rs.getString("COLUMN_NAME"),
                        rs.getInt("ORDINAL_POSITION"),
                        displayType(typeName, shownSize, shownScale),
                        shownSize,
                        shownScale,
                        isNullable,
                        defaultValue,
                        "YES".equalsIgnoreCase(rs.getString("IS_AUTOINCREMENT")),
                        blankToNull(rs.getString("REMARKS"))));
            }
        }
        columns.sort(Comparator.comparingInt(Column::position));
        return columns;
    }

    /** Types whose size is part of their definition. ENUM/SET report a CHAR type code but carry no length. */
    private static boolean isSized(int dataType, String typeName) {
        if (typeName != null) {
            String t = typeName.toUpperCase(Locale.ROOT);
            if (t.contains("(") || t.startsWith("ENUM") || t.startsWith("SET")) {
                return false;
            }
        }
        return switch (dataType) {
            case Types.CHAR, Types.VARCHAR, Types.NCHAR, Types.NVARCHAR, Types.BINARY, Types.VARBINARY -> true;
            default -> false;
        };
    }

    static String displayType(String typeName, Integer size, Integer scale) {
        String base = typeName == null ? "?" : typeName;
        if (size == null) {
            return base;
        }
        if (scale == null) {
            return base + "(" + (size >= MAX_SIZE_MARKER ? "max" : size) + ")";
        }
        return base + "(" + size + "," + scale + ")";
    }

    /**
     * mssql-jdbc reports an IDENTITY column's type as {@code int identity}; the column's {@code autoIncrement} already
     * says that, and the suffix would make the type read differently from the DDL that declared it.
     */
    static String typeName(String raw) {
        if (raw == null) {
            return null;
        }
        String t = raw.strip();
        return t.regionMatches(true, Math.max(0, t.length() - 9), " identity", 0, 9) && t.length() > 9
                ? t.substring(0, t.length() - 9) : t;
    }

    private static PrimaryKey readPrimaryKey(DatabaseMetaData meta, String catalog, String schema, String table)
            throws SQLException {
        TreeMap<Short, String> columns = new TreeMap<>();
        String pkName = null;
        try (ResultSet rs = meta.getPrimaryKeys(catalog, schema, table)) {
            while (rs.next()) {
                if (!table.equals(rs.getString("TABLE_NAME"))) {
                    continue;
                }
                columns.put(rs.getShort("KEY_SEQ"), rs.getString("COLUMN_NAME"));
                pkName = blankToNull(rs.getString("PK_NAME"));
            }
        }
        return columns.isEmpty() ? null : new PrimaryKey(pkName, List.copyOf(columns.values()));
    }

    /**
     * Unique and non-unique indexes, minus the one backing the primary key — that is already reported as
     * {@code primaryKey}. Recognized by name (MySQL {@code PRIMARY}, PostgreSQL {@code <table>_pkey}) or, where the
     * vendor names it differently from the constraint (H2), as the unique index over exactly the key's columns.
     */
    private static List<Index> readIndexes(DatabaseMetaData meta, String catalog, String schema, String table,
                                           PrimaryKey primaryKey) throws SQLException {
        Map<String, TreeMap<Short, String>> columnsByIndex = new LinkedHashMap<>();
        Map<String, Boolean> uniqueByIndex = new HashMap<>();
        // approximate=TRUE IS LOAD-BEARING, not a speed hint. With false, ojdbc runs ANALYZE TABLE … COMPUTE
        // STATISTICS to make the statistic row exact — a write to the dictionary, on a read-only tool, against
        // whatever table the caller named. The statistic row is discarded below anyway.
        try (ResultSet rs = meta.getIndexInfo(catalog, schema, table, false, true)) {
            while (rs.next()) {
                String indexName = rs.getString("INDEX_NAME");
                String column = rs.getString("COLUMN_NAME");
                if (rs.getShort("TYPE") == DatabaseMetaData.tableIndexStatistic || indexName == null
                        || column == null || !table.equals(rs.getString("TABLE_NAME"))) {
                    continue;
                }
                columnsByIndex.computeIfAbsent(indexName, k -> new TreeMap<>())
                        .put(rs.getShort("ORDINAL_POSITION"), column);
                uniqueByIndex.put(indexName, !rs.getBoolean("NON_UNIQUE"));
            }
        }
        List<Index> indexes = new ArrayList<>();
        for (Map.Entry<String, TreeMap<Short, String>> e : columnsByIndex.entrySet()) {
            Index index = new Index(e.getKey(), uniqueByIndex.get(e.getKey()), List.copyOf(e.getValue().values()));
            if (!backsPrimaryKey(index, primaryKey)) {
                indexes.add(index);
            }
        }
        indexes.sort(Comparator.comparing((Index i) -> !i.unique()).thenComparing(Index::name));
        return indexes;
    }

    private static boolean backsPrimaryKey(Index index, PrimaryKey primaryKey) {
        if (primaryKey == null) {
            return false;
        }
        return index.name().equalsIgnoreCase("PRIMARY")
                || index.name().equalsIgnoreCase(primaryKey.name())
                || (index.unique() && index.columns().equals(primaryKey.columns()));
    }

    /** Groups getImportedKeys/getExportedKeys rows (one per column) into keys, columns in KEY_SEQ order. */
    private static List<ForeignKey> readForeignKeys(ResultSet rs, Location location, boolean imported)
            throws SQLException {
        record Part(String name, String otherTable, TreeMap<Short, String[]> pairs, String onUpdate,
                    String onDelete) {
        }
        Map<String, Part> parts = new LinkedHashMap<>();
        while (rs.next()) {
            String otherTable = imported
                    ? qualified(rs.getString("PKTABLE_CAT"), rs.getString("PKTABLE_SCHEM"),
                    rs.getString("PKTABLE_NAME"), location)
                    : qualified(rs.getString("FKTABLE_CAT"), rs.getString("FKTABLE_SCHEM"),
                    rs.getString("FKTABLE_NAME"), location);
            String fkName = blankToNull(rs.getString("FK_NAME"));
            String onUpdate = rule(intOrNull(rs, "UPDATE_RULE"));
            String onDelete = rule(intOrNull(rs, "DELETE_RULE"));
            String key = (fkName == null ? "" : fkName) + "\u0000" + otherTable;
            Part part = parts.computeIfAbsent(key,
                    k -> new Part(fkName, otherTable, new TreeMap<>(), onUpdate, onDelete));
            // fk column → pk column; for referencedBy the fk side is the OTHER table's.
            part.pairs().put(rs.getShort("KEY_SEQ"),
                    new String[] {rs.getString("FKCOLUMN_NAME"), rs.getString("PKCOLUMN_NAME")});
        }
        List<ForeignKey> keys = new ArrayList<>();
        for (Part part : parts.values()) {
            List<String> fkColumns = part.pairs().values().stream().map(p -> p[0]).toList();
            List<String> pkColumns = part.pairs().values().stream().map(p -> p[1]).toList();
            keys.add(new ForeignKey(part.name(), fkColumns, part.otherTable(), pkColumns,
                    part.onUpdate(), part.onDelete()));
        }
        keys.sort(Comparator.comparing(ForeignKey::otherTable).thenComparing(
                k -> k.name() == null ? "" : k.name()));
        return keys;
    }

    /** A table in the same location is shown bare; one elsewhere carries its catalog/schema. */
    private static String qualified(String catalog, String schema, String table, Location location) {
        StringBuilder sb = new StringBuilder();
        if (catalog != null && !catalog.equalsIgnoreCase(location.database())) {
            sb.append(catalog).append('.');
        }
        if (schema != null && location.schema() != null && !schema.equalsIgnoreCase(location.schema())) {
            sb.append(schema).append('.');
        }
        return sb.append(table).toString();
    }

    /**
     * A JDBC referential-action code as SQL. NULL is NO ACTION — and must be checked before the switch: ojdbc reports
     * UPDATE_RULE as NULL (Oracle has no ON UPDATE), and {@code getInt} turns NULL into 0, which is
     * {@code importedKeyCascade}. Read with getInt, every Oracle foreign key claimed ON UPDATE CASCADE.
     */
    static String rule(Integer code) {
        if (code == null) {
            return "NO ACTION";
        }
        return switch (code) {
            case DatabaseMetaData.importedKeyCascade -> "CASCADE";
            case DatabaseMetaData.importedKeyRestrict -> "RESTRICT";
            case DatabaseMetaData.importedKeySetNull -> "SET NULL";
            case DatabaseMetaData.importedKeySetDefault -> "SET DEFAULT";
            default -> "NO ACTION";
        };
    }

    /** MySQL reports the literal comment "VIEW" for every view; that is not a comment anyone wrote. */
    private static String comment(String remarks, TableType type) {
        String c = blankToNull(remarks);
        return type == TableType.VIEW && "VIEW".equals(c) ? null : c;
    }

    private static String like(String value, String escape) {
        if (value == null || escape == null || escape.isEmpty()) {
            return value;
        }
        return value.replace(escape, escape + escape).replace("_", escape + "_").replace("%", escape + "%");
    }

    private static Integer intOrNull(ResultSet rs, String column) throws SQLException {
        int value = rs.getInt(column);
        return rs.wasNull() ? null : value;
    }

    private static String blankToNull(String s) {
        return s == null || s.isBlank() ? null : s.strip();
    }
}
