# Settings sample for docker compose.
#   cp .env.example .env
# .env is gitignored — secrets are not committed.
# A production deployment injects these from a secret manager (Vault/KMS) or GitHub Environment secrets, not
# from this file.

# ─────────────────────────────────────────────────────────────────────────────
# Port / identity
# ─────────────────────────────────────────────────────────────────────────────
# ONE port concept: this single value decides the container bind port, the host published port, and the resource
# identifier MCP discovery advertises.
# The only other thing that moves with it is protean.mcp.authorization.resource, which application.yml assembles
# automatically. OAUTH_ISSUER_URI does NOT move with it — that names an external server (see below).
SERVER_PORT={{PORT}}

# The ADVERTISED hostname, not a bind address. Behind a reverse proxy, put the name the client sees.
SERVER_HOST=localhost

# ★ REQUIRED. There is no default anywhere.
#   ★ NOT this app's own address. It is the EXTERNAL Authorization Server's issuer identifier and must match
#   what that server stamps as `iss`, character for character. Get it wrong and the app starts perfectly while
#   every request 401s.
#   ⚠ Do not use localhost — inside a container localhost is that container itself. Use a hostname or LAN IP the
#   MCP client can actually reach, e.g. http://auth.example.internal:9300
#
#   ★ LEFT EMPTY ON PURPOSE. A plausible-looking example value would let a copied .env start the app
#   SUCCESSFULLY and then 401 every request — the hardest failure in this project to diagnose. Empty means
#   docker-compose's :? guard stops before the container is created, same as DB_HOST.
OAUTH_ISSUER_URI=

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
# The schema name is hardcoded in application.yml's JDBC URL. Only the four below change.
# (For anything else, override the whole URL with SPRING_DATASOURCE_URL.)
#
# ★ DB_HOST and DB_USER are required too. application.yml has no fallback, and an unset value is as silent as
#   DB_PASSWORD — the Binder leaves the literal "${DB_HOST}" in place, surfacing as UnknownHostException.
#   The :? guards in docker-compose.yml and the check in setup.sh catch it earlier.
#
# ★ These lines are needed even with the sidecar overlay (docker-compose.local-db.yml) — set DB_HOST=mysql.
#   compose interpolates each -f file separately and then merges, so the overlay's `DB_HOST: mysql` does not
#   exempt the base file's :? guard. DB_USER is the name the sidecar account is created with (anything works).
DB_HOST=
DB_PORT=3306
DB_USER=

# ★ REQUIRED. application.yml carries no password.
#   With the sidecar overlay this doubles as the password the sidecar account is created with.
DB_PASSWORD=


# ─────────────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────────────
IMAGE_TAG=local
JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# ─────────────────────────────────────────────────────────────────────────────
# Local MySQL sidecar only (when adding docker-compose.local-db.yml)
# ─────────────────────────────────────────────────────────────────────────────
# Uncomment the line below to bring the sidecar up without passing -f every time.
# COMPOSE_FILE=docker-compose.yml:docker-compose.local-db.yml
# MYSQL_ROOT_PASSWORD=root-pw
# If the host already has MySQL on 3306, step aside (the app connects to mysql:3306, so this does not affect it).
# MYSQL_HOST_PORT=13306
