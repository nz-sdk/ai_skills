// The two query tools through the REAL MCP surface — POST /platform/mcp, the security chain, ExampleAuthorizer and
// protean's dispatcher with strict-schema on — which the unit tests only imitate:
//   · an mcp.read token is refused by the authorizer (PERMISSION_DENIED), an mcp.write token gets through
//   · a successful result survives the dispatcher's own outputSchema check (it would come back as
//     OUTPUT_SCHEMA_VIOLATION otherwise) — `plan` included, whose type differs per vendor
//   · an argument the inputSchema does not declare is rejected before the tool runs
//
// OFFLINE, LIKE ResourceServerOnlyTest (whose @DynamicPropertySource this copies): an `.invalid` issuer that is never
// fetched, a filesystem module store, and — the one difference — an in-memory H2 as the host DataSource.
package {{PKG}}.db.query;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.node.ObjectNode;

import {{PKG}}.db.DbFixtures;

import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.http.MediaType;
import org.springframework.security.core.GrantedAuthority;
import org.springframework.security.core.authority.SimpleGrantedAuthority;
import org.springframework.test.context.DynamicPropertyRegistry;
import org.springframework.test.context.DynamicPropertySource;
import org.springframework.test.web.servlet.MockMvc;
import org.springframework.test.web.servlet.request.RequestPostProcessor;

import javax.sql.DataSource;
import java.nio.file.Path;
import java.util.Arrays;
import java.util.List;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertTrue;
import static org.springframework.security.test.web.servlet.request.SecurityMockMvcRequestPostProcessors.jwt;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.MOCK)
@AutoConfigureMockMvc
class QueryToolsMcpEndToEndTest {

    static final String ISSUER = "https://example-idp.invalid/realms/x";
    static final String RESOURCE = "http://localhost:8080/platform/mcp";
    static final Path storeDir = Path.of("build", "test-query-store-" + System.nanoTime());

    @DynamicPropertySource
    static void props(DynamicPropertyRegistry r) {
        r.add("spring.security.oauth2.resourceserver.jwt.issuer-uri", () -> ISSUER);
        r.add("protean.mcp.authorization.resource", () -> RESOURCE);
        r.add("protean.mcp.authorization.authorization-servers[0]", () -> ISSUER);
        r.add("protean.module-store.dir", storeDir::toString);
        r.add("protean.module-store.backend", () -> "filesystem");
        r.add("spring.datasource.url", () -> "jdbc:h2:mem:query_e2e_" + System.nanoTime() + ";DB_CLOSE_DELAY=-1");
        r.add("spring.datasource.driver-class-name", () -> "org.h2.Driver");
        r.add("spring.datasource.username", () -> "sa");
        r.add("spring.datasource.password", () -> "");
    }

    @Autowired
    MockMvc mvc;

    @Autowired
    ObjectMapper mapper;

    @Autowired
    DataSource dataSource;

    private static boolean schemaApplied;

    @BeforeEach
    void schema() {
        if (!schemaApplied) {
            DbFixtures.exec(dataSource, DbFixtures.SCHEMA);
            DbFixtures.exec(dataSource, "INSERT INTO comp_mst (comp_cd, comp_nm) VALUES ('A01', '회사A')");
            schemaApplied = true;
        }
    }

    static RequestPostProcessor agent(String... scopes) {
        return jwt()
                .jwt(j -> j.subject("bridge-mcp-agent").claim("client_id", "bridge-mcp-agent")
                        .audience(List.of(RESOURCE)).claim("scope", List.of(scopes)))
                .authorities(Arrays.stream(scopes).<GrantedAuthority>map(s -> new SimpleGrantedAuthority("SCOPE_" + s))
                        .toList());
    }

    private JsonNode call(RequestPostProcessor token, String tool, ObjectNode arguments) throws Exception {
        ObjectNode request = mapper.createObjectNode().put("jsonrpc", "2.0").put("id", 1).put("method", "tools/call");
        request.putObject("params").put("name", tool).set("arguments", arguments);
        String body = mvc.perform(post("/platform/mcp").with(token)
                        .contentType(MediaType.APPLICATION_JSON)
                        .accept(MediaType.APPLICATION_JSON, MediaType.TEXT_EVENT_STREAM)
                        .content(mapper.writeValueAsString(request)))
                .andExpect(status().isOk())
                .andReturn().getResponse().getContentAsString();
        JsonNode response = mapper.readTree(body);
        assertTrue(response.has("result"), () -> "not a tool result: " + body);
        return response.path("result");
    }

    /**
     * A coded tool error's code. protean 0.0.1 put the problem in structuredContent; 0.0.2 moved it to
     * result._meta["org.htcom.protean/problem"] (structuredContent is the tool's own schema's, not the error's).
     */
    private static String code(JsonNode result) {
        JsonNode inStructured = result.path("structuredContent").path("code");
        return inStructured.isTextual() ? inStructured.asText()
                : result.path("_meta").path("org.htcom.protean/problem").path("code").asText();
    }

    private ObjectNode sql(String sql) {
        return mapper.createObjectNode().put("sql", sql);
    }

    @Test
    void mcpReadIsRefusedByTheAuthorizer() throws Exception {
        for (String tool : List.of("amoeba.select_query", "amoeba.explain_query")) {
            JsonNode result = call(agent("mcp.read"), tool, sql("SELECT comp_cd FROM comp_mst"));
            assertTrue(result.path("isError").asBoolean(), result.toString());
            assertEquals("PERMISSION_DENIED", code(result), result.toString());
        }
    }

    @Test
    void mcpWriteRunsAndTheResultPassesTheDispatchersSchemaCheck() throws Exception {
        JsonNode rows = call(agent("mcp.write"), "amoeba.select_query", sql("SELECT comp_cd, comp_nm FROM comp_mst"));
        assertFalse(rows.path("isError").asBoolean(), rows.toString());
        assertEquals(1, rows.path("structuredContent").path("rowCount").asInt(), rows.toString());
        assertEquals("회사A", rows.path("structuredContent").path("rows").get(0).get(1).asText(), rows.toString());
        assertEquals("SELECT comp_cd, comp_nm FROM comp_mst FETCH FIRST 101 ROWS ONLY",
                rows.path("structuredContent").path("executedSql").asText(), "the sent statement carries a limit");

        JsonNode plan = call(agent("mcp.write"), "amoeba.explain_query", sql("SELECT comp_nm FROM comp_mst"));
        assertFalse(plan.path("isError").asBoolean(), plan.toString());
        assertEquals("h2", plan.path("structuredContent").path("vendor").asText(), plan.toString());
    }

    @Test
    void anUndeclaredArgumentIsRejectedBeforeTheToolRuns() throws Exception {
        JsonNode result = call(agent("mcp.write"), "amoeba.select_query",
                sql("SELECT 1").put("statement", "DELETE FROM comp_mst"));
        assertTrue(result.path("isError").asBoolean(), result.toString());
        assertEquals("INVALID_ARGUMENT", code(result), result.toString());
    }

    @Test
    void aWriteIsNotRunEvenWithMcpWrite() throws Exception {
        JsonNode result = call(agent("mcp.write"), "amoeba.select_query", sql("DELETE FROM comp_mst"));
        assertTrue(result.path("isError").asBoolean(), result.toString());
        assertTrue(result.toString().contains("not run"), result.toString());
        JsonNode count = call(agent("mcp.write"), "amoeba.select_query", sql("SELECT COUNT(*) FROM comp_mst"));
        assertEquals(1, count.path("structuredContent").path("rows").get(0).get(0).asInt(), count.toString());
    }
}
